rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Autorisation : le rôle vient du jeton, la révocation du document ─────
    //
    // Le rôle et la révocation vivent tous deux dans `users/{uid}` ET dans les
    // custom claims du jeton, entretenus par le déclencheur `syncUserClaims`.
    // Les règles Storage ne peuvent lire que le jeton — une lecture Firestore
    // depuis Storage est facturée et, surtout, peut échouer et faire refuser la
    // règle entière. Ces règles-ci, elles, ont accès aux deux sources. Le choix
    // n'est donc pas « l'une ou l'autre » mais « laquelle pour quoi » :
    //
    //  • Le RÔLE passe par le jeton. Il change rarement, une latence d'une
    //    heure sur une promotion est sans conséquence, et le lire dans le jeton
    //    évite une lecture facturée par requête. Repli sur le document tant
    //    qu'un jeton ne porte pas encore le claim : sans ce repli, la bascule
    //    aurait mis dehors tous les comptes non rafraîchis.
    //
    //  • La RÉVOCATION reste lue sur le document. C'est le seul contrôle qui
    //    doit mordre immédiatement : couper l'accès à quelqu'un et devoir
    //    attendre le renouvellement de son jeton n'est pas une révocation.
    //    Le jeton peut la confirmer, jamais l'infirmer.
    //
    // Écart assumé et connu : sur Storage, une révocation ne prend effet qu'au
    // renouvellement du jeton (une heure au plus). Ici elle est immédiate.

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    /// Vrai si le jeton porte le claim de rôle (compte amorcé, jeton à jour).
    /// Testé par présence de clé plutôt que par comparaison à null : c'est la
    /// seule forme dont la sémantique est garantie sur un claim absent.
    function tokenHasRole() {
      return 'role' in request.auth.token && request.auth.token.role != null;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        tokenHasRole()
          ? request.auth.token.role == role
          : getUserData().role == role
      );
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isEditor() {
      return hasRole('editor') || isAdmin();
    }

    /// Le jeton peut confirmer une révocation, jamais l'infirmer : un compte
    /// révoqué après l'émission de son jeton doit perdre l'accès tout de suite.
    function isRevoked() {
      return ('revoked' in request.auth.token && request.auth.token.revoked == true)
        || getUserData().is_revoked == true;
    }

    function isReader() {
      return isAuthenticated() && !isRevoked();
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Collection users
    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin() || isEditor());
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == uid
                      && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['role', 'is_revoked']));
      allow delete: if isAdmin();

      // Préférences nutrition persistées par utilisateur/recette.
      match /nutrition_portion_overrides/{recipeId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // Collection books
    match /books/{bookId} {
      allow read: if isReader();
      allow create, update, delete: if isEditor();
    }

    // Collection recipes
    match /recipes/{recipeId} {
      // Brouillons visibles par editors/admins ou par le créateur
      allow read: if isReader() &&
        (resource.data.review_status == 'validated'
          || isEditor()
          || isOwner(resource.data.created_by));

      // Création : editors/admins, ou tout utilisateur authentifié pour ses propres brouillons
      allow create: if isEditor() || (isAuthenticated() && request.resource.data.created_by == request.auth.uid);

      // Mise à jour : editors/admins OU le créateur (pour ses propres recettes)
      allow update: if isEditor() || isOwner(resource.data.created_by);

      // Suppression : editors/admins OU le créateur (pour ses propres brouillons/recettes)
      allow delete: if isEditor() || isOwner(resource.data.created_by);

      // Annotations
      match /annotations/{annotationId} {
        allow read: if isReader();
        allow create: if isReader();
        allow update, delete: if isOwner(resource.data.uid) || isAdmin();
      }
    }

    // Notes de recettes (recipe_ratings)
    match /recipe_ratings/{ratingId} {
      allow read: if isReader();
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      // `write` couvrait aussi la création, où `resource` n'existe pas encore :
      // la clause était donc toujours fausse à la création et seule la règle
      // `create` opérait. Dire explicitement ce qui est permis vaut mieux
      // qu'une règle dont une moitié ne s'applique jamais.
      allow update, delete: if isOwner(resource.data.user_id) || isAdmin();
    }

    // Groupes familiaux
    match /groups/{groupId} {
      allow read: if isReader() &&
        (resource.data.owner_id == request.auth.uid
          || request.auth.uid in resource.data.member_ids);
      allow create: if isReader();
      allow update, delete: if isOwner(resource.data.owner_id) || isAdmin();
    }

    // app_config contient DEUX natures de documents :
    //  - `usage` : compteurs de scans et de stockage, écrits par le client ;
    //  - la politique nutrition, lue par les Cloud Functions comme autorité.
    // Ouvrir l'écriture à tout le monde laissait n'importe quel utilisateur
    // authentifié réécrire cette politique. L'écriture client est donc bornée
    // au seul document de compteurs.
    match /app_config/{docId} {
      allow read: if isAdmin() || (isAuthenticated() && docId == 'usage');
      allow write: if isAdmin() || (isAuthenticated() && docId == 'usage');
    }

    // Jobs de traitement IA
    //
    // Le traitement se fait entièrement côté backend (Cloud Tasks). Le client
    // ne fait plus que deux choses sur un job existant : le relancer et
    // l'annuler. Il n'a donc plus à pouvoir écrire le résultat du traitement —
    // l'écriture lui était ouverte en grand du temps où il traitait lui-même.
    match /processing_jobs/{jobId} {
      function isJobOwner() {
        return isAuthenticated() && resource.data.created_by == request.auth.uid;
      }

      // Champs qu'une relance ou une annulation touche, et eux seuls.
      function touchesOnlyRetryOrCancelFields() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'error_message', 'current_step', 'cancel_requested',
          'created_recipe_ids', 'created_book_id', 'updated_at'
        ]);
      }

      allow read: if isEditor() || isJobOwner();
      allow create: if isEditor() || (isAuthenticated() && request.resource.data.created_by == request.auth.uid);
      allow update: if isAdmin() || (isJobOwner() && touchesOnlyRetryOrCancelFields());
      allow delete: if isAdmin();
    }

    // Suivi de l'usage des tokens IA
    match /ai_usage/{docId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Repas planifiés
    match /planned_meals/{mealId} {
      allow read, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Préférences de planning
    match /planning_config/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // Rapports d'erreur
    match /error_reports/{reportId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.user_id == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Dead Letter Queue — uniquement administrable.
    // Écriture déléguée aux Cloud Functions (Admin SDK contourne ces règles).
    match /dead_letters/{dlqId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Réconciliation mensuelle IA (estimé vs facturé vs non attribué).
    match /ai_reconciliation_monthly/{periodId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Référentiel nutrition (per100g) : lu par le détail nutritionnel d'une
    // recette, donc par tout utilisateur, pas seulement l'admin. L'écriture
    // reste réservée aux Cloud Functions (Admin SDK, hors de ces règles).
    match /nutrition_ingredients/{ingredientId} {
      allow read: if isReader();
      allow write: if false;
    }

    // Référentiel des unités : source de vérité des conversions, lue par le
    // client comme par le backend. Administrable via l'écran Admin.
    match /nutrition_units/{unitId} {
      allow read: if isReader();
      allow write: if isAdmin();
    }
  }
}
