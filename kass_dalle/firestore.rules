rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Autorisation : le rôle et la révocation viennent du document ───────
    //
    // Le rôle et la révocation vivent tous deux dans `users/{uid}` ET dans les
    // custom claims du jeton, entretenus par le déclencheur `syncUserClaims`.
    // Les règles Storage ne peuvent lire que le jeton — une lecture Firestore
    // depuis Storage est facturée et, surtout, peut échouer et faire refuser la
    // règle entière. Ces règles-ci ont accès aux deux sources, et lisent
    // d'abord le document :
    //
    //  • Le RÔLE se lit sur le document, et sur le jeton seulement quand le
    //    document n'en porte pas. Il se lisait dans le jeton avant la
    //    v0.24.30 : un administrateur rétrogradé gardait le claim `admin`
    //    jusqu'au renouvellement de son jeton (une heure au plus), et pouvait
    //    pendant ce temps se renommer administrateur sur son propre document
    //    (ticket #162). La lecture du document ne coûte rien de plus :
    //    `isRevoked()` la fait déjà, et une même requête ne facture qu'une
    //    lecture par document. Même ordre côté Functions (`callable/_auth.ts`).
    //
    //  • La RÉVOCATION se lit sur le document. Couper l'accès à quelqu'un et
    //    devoir attendre le renouvellement de son jeton n'est pas une
    //    révocation. Le jeton peut la confirmer, jamais l'infirmer.
    //
    // Sans document — première connexion, avant que `_upsertUser` ne l'écrive
    // — `getUserData()` échoue, et une erreur vaut refus : un tel compte n'a
    // que les droits qui ne demandent aucun rôle (créer son document,
    // `isKnownRevoked` pour les rapports d'erreur). C'était déjà le cas par
    // `isRevoked()` avant v0.24.30.
    //
    // Écart assumé et connu : sur Storage, le rôle et la révocation ne
    // changent qu'au renouvellement du jeton (une heure au plus). Ici ils
    // changent immédiatement.
    //
    // Quatre rôles, dont un qui n'ouvre rien : `pending`. Un compte neuf naît
    // ainsi, et `isApproved()` — pas `isAuthenticated()` — garde tout ce qui
    // est partagé. Le rôle ne se choisit pas soi-même : la règle de création
    // l'impose, et seul un administrateur le change ensuite.

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    /// Le rôle en vigueur : celui du document, ou le claim du jeton quand le
    /// document ne porte pas de rôle (compte ancien). Le document fait foi :
    /// un rôle retiré mord tout de suite, sans attendre le jeton.
    function roleOf() {
      let d = getUserData();
      return d.get('role', null) != null ? d.role : request.auth.token.get('role', null);
    }

    /// Les trois rôles qui ouvrent l'application. `pending` n'y est pas : un
    /// compte fraîchement créé attend qu'un administrateur le nomme.
    function approvedRoles() {
      return ['reader', 'editor', 'admin'];
    }

    /// Un rôle ne suffit pas : il faut aussi ne pas être révoqué.
    ///
    /// Le contrôle manquait ici, et c'était le trou le plus large de ces
    /// règles : `isEditor()` et `isAdmin()` ne regardaient que le rôle, si
    /// bien qu'un éditeur révoqué continuait d'écrire livres, recettes et
    /// référentiels. Révoquer un administrateur ne faisait rien du tout.
    function hasRole(role) {
      return isAuthenticated() && !isRevoked() && roleOf() == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isEditor() {
      return hasRole('editor') || isAdmin();
    }

    /// Le jeton peut confirmer une révocation, jamais l'infirmer : un compte
    /// révoqué après l'émission de son jeton doit perdre l'accès tout de suite.
    function isRevoked() {
      return ('revoked' in request.auth.token && request.auth.token.revoked == true)
        || getUserData().is_revoked == true;
    }

    /// Le sas d'entrée : être connecté ne donne plus accès à la bibliothèque.
    ///
    /// Auparavant toute personne possédant un compte Google lisait, dès sa
    /// première connexion, l'intégralité des livres et des recettes validées
    /// de la famille. Il faut désormais qu'un administrateur ait nommé le
    /// compte — `pending` ne lit rien.
    function isApproved() {
      return isAuthenticated() && !isRevoked() && roleOf() in approvedRoles();
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    /// Identifiants des documents de `users/{uid}/preferences` que le client
    /// écrit : `book_order` (`BookRepository`), `explore_filters`
    /// (`ExplorePreferencesRepository`), `meal_staples`
    /// (`MealStaplesRepository`), `planning_refusals`
    /// (`PlanningRefusalsRepository`), `planning_visibility`
    /// (`PlanningVisibilityStore`), `recipe_search_scope`
    /// (`PlanningRepository`). Un nouveau document s'ajoute ici, avec son test.
    function knownPreferenceIds() {
      return ['book_order', 'explore_filters', 'meal_staples', 'planning_refusals',
              'planning_visibility', 'recipe_search_scope'];
    }

    /// Forme de `users/{uid}/preferences/planning_refusals` :
    /// `{ entries: { recipeId: { refused_at, count } }, updated_at }`.
    function isPlanningRefusals(data) {
      return data.keys().hasOnly(['entries', 'updated_at'])
        && data.entries is map
        && data.entries.size() <= 300
        && (!('updated_at' in data) || data.updated_at is timestamp);
    }

    /// Forme de `users/{uid}/preferences/planning_visibility` (plannings
    /// affichés) : `{ editor: list, reader: list, updated_at }`, une liste de
    /// clés de planning par rôle, cent au plus.
    function isPlanningVisibility(data) {
      return data.keys().hasOnly(['editor', 'reader', 'updated_at'])
        && (!('editor' in data) || (data.editor is list && data.editor.size() <= 100))
        && (!('reader' in data) || (data.reader is list && data.reader.size() <= 100))
        && (!('updated_at' in data) || data.updated_at is timestamp);
    }

    /// Forme de `users/{uid}/preferences/explore_filters` (écran Explorer) :
    /// `{ sources: list, sort: string, filters: map, updated_at }`. Bornée pour
    /// qu'une préférence de lecteur ne serve pas de stockage libre.
    function isExploreFilters(data) {
      return data.keys().hasOnly(['sources', 'sort', 'filters', 'updated_at'])
        && (!('sources' in data) || (data.sources is list && data.sources.size() <= 10))
        && (!('sort' in data) || (data.sort is string && data.sort.size() <= 32))
        && (!('filters' in data) || (data.filters is map && data.filters.size() <= 20))
        && (!('updated_at' in data) || data.updated_at is timestamp);
    }

    /// Le compte fondateur, seul à pouvoir se nommer administrateur sans que
    /// personne ne l'y autorise — et seul à pouvoir toucher à son propre rôle.
    ///
    /// Comparé en minuscules : Google rend l'adresse normalisée, mais une
    /// casse différente ne doit pas décider d'un droit.
    function founderEmail() {
      return 'china.fred.75@gmail.com';
    }

    ///
    /// L'adresse seule ne suffit pas : elle doit être vérifiée, et la
    /// connexion passer par Google (audit sécurité, « à confirmer »). Un
    /// fournisseur qui accepte une adresse non vérifiée — e-mail et mot de
    /// passe — aurait suffi à se faire reconnaître fondateur. Même contrôle
    /// côté serveur : `isFounderAccount` (`triggers/founderRole.ts`).
    function isFounder() {
      return isAuthenticated() && 'email' in request.auth.token
        && request.auth.token.email.lower() == founderEmail()
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'google.com';
    }

    // Collection users
    //
    // La création est le point qui manquait de garde. La règle se contentait
    // de vérifier que l'on écrivait bien son propre document : le rôle, lui,
    // était choisi par le client. N'importe qui pouvait donc créer son compte
    // avec `role: "admin"` — et `syncUserClaims`, qui fait confiance au
    // document, lui frappait le claim correspondant. Le rôle d'un compte neuf
    // est désormais imposé : `pending`, non révoqué, et l'adresse de son
    // propre jeton. Nommer quelqu'un reste un geste d'administrateur.
    match /users/{uid} {
      function touchesAuthority() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['role', 'is_revoked']);
      }

      /// L'adresse d'un compte ne change plus après sa création — pour
      /// personne, administrateur compris. Seul le serveur (Admin SDK, hors
      /// règles) peut la réécrire.
      ///
      /// Elle était figée pour le titulaire seul : un administrateur pouvait
      /// remplacer l'adresse du fondateur, puis, le document ne le désignant
      /// plus, changer son rôle ou le supprimer (audit sécurité, faille 7).
      /// Testé par `affectedKeys()` : un document ancien sans `email` reste
      /// modifiable, tant que la mise à jour n'en ajoute pas.
      function touchesEmail() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['email']);
      }

      /// Le document désigne-t-il le compte fondateur ? Son adresse est
      /// verrouillée à la création (égale à celle du jeton) et ne peut plus
      /// changer ensuite (`touchesEmail`) : elle fait donc foi ici.
      function targetIsFounder() {
        return resource.data.get('email', '').lower() == founderEmail();
      }

      /// Un nom (`display_name`, `preferred_name`) est absent, nul, ou une
      /// chaîne de 60 caractères au plus. Il est recopié tel quel dans le
      /// profil public que lit toute la famille : sans borne, un compte
      /// pouvait y poser un texte de plusieurs centaines de kilo-octets
      /// (revue sécurité v0.23.14). Le serveur tronque aussi à la recopie
      /// (`publicProfileFrom`), et le client avant d'écrire.
      function nameOk(field) {
        return !(field in request.resource.data)
               || request.resource.data[field] == null
               || (request.resource.data[field] is string
                   && request.resource.data[field].size() <= 60);
      }

      /// La couverture « Recette libre » (`free_recipe_cover_url`) est
      /// absente, nulle, ou l'adresse de téléchargement exacte que produit la
      /// modération (`targetPathFor`, `moderation/promote.ts`) :
      /// `users/{uid du document}/free_recipe_cover_{horodatage}.{extension}`,
      /// dans le bucket du projet, de 500 caractères au plus. Le chemin est
      /// fermé caractère par caractère : ni `..`, ni `%2E`, ni `%25` — un
      /// `[^/#]+` laissait viser `users%2F..%2Fquarantine%2F…`, un fichier non
      /// modéré. Seul le titulaire change sa couverture dans le client, et
      /// la modération la publie sous son propre uid. Elle est recopiée dans `user_profiles`, lu par
      /// toute la famille : une adresse externe y passait sans modération
      /// (audit sécurité, « Faible »). Même expression côté serveur
      /// (`publicCoverUrl`, `triggers/userPublicProfile.ts`).
      function coverUrlOk() {
        let url = request.resource.data.get('free_recipe_cover_url', null);
        return url == null
          || (url is string && url.size() <= 500
              && url.matches('https://firebasestorage[.]googleapis[.]com/v0/b/kassdale-6d948[.](firebasestorage[.]app|appspot[.]com)/o/users%2F'
                             + uid + '%2Ffree_recipe_cover_[0-9]+[.](jpg|jpeg|png|webp)([?][^/#%]*)?'));
      }

      /// La photo Google (`photo_url`) est absente, nulle, ou une chaîne de
      /// 2048 caractères au plus. Elle n'est lue que par son titulaire
      /// (`account_screen`) et par l'administrateur, et n'est recopiée nulle
      /// part : la borne empêche seulement qu'un compte grossisse son propre
      /// document d'un texte de taille quelconque.
      function photoUrlOk() {
        let url = request.resource.data.get('photo_url', null);
        return url == null || (url is string && url.size() <= 2048);
      }

      /// Les champs que le client écrit à la création (`AppUser.toFirestore`,
      /// appelé par `_upsertUser`). `uid`, quand il est écrit, est l'uid du
      /// document : `watchAllUsers` le lisait comme identifiant du compte, si
      /// bien qu'un compte en attente qui portait l'uid d'un éditeur faisait
      /// révoquer l'éditeur par un clic sur sa propre ligne (ticket #162).
      function createdKeysOk() {
        return request.resource.data.keys().hasOnly([
                 'uid', 'email', 'display_name', 'preferred_name', 'photo_url',
                 'free_recipe_cover_url', 'role', 'created_at', 'last_seen_at',
                 'is_revoked'])
               && (!('uid' in request.resource.data) || request.resource.data.uid == uid)
               && request.resource.data.get('created_at', null) is timestamp
               && request.resource.data.get('last_seen_at', null) is timestamp
               && request.resource.data.get('display_name', null) is string;
      }

      /// Un champ que la mise à jour modifie, ajoute ou retire.
      function changes(field) {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny([field]);
      }

      /// Types que lit `AppUser.fromFirestore` sans repli : un champ absent ou
      /// d'un autre type lève une exception à la lecture. Les dates et le nom
      /// Google sont obligatoires à la création (`createdKeysOk`) ; l'adresse,
      /// le rôle et la révocation y sont fixés par égalité ; le nom préféré et
      /// la couverture par `nameOk` et `coverUrlOk`. Il restait la mise à jour
      /// (ticket #162, relecture sécurité) : `last_seen_at: "x"` ou
      /// `display_name: null` faisaient tomber Admin › Comptes pour tous les
      /// administrateurs. Un retrait de champ échoue aussi : la valeur
      /// absente n'a pas le type demandé.
      ///
      /// Le rôle n'est pas seulement une chaîne : l'une des quatre valeurs
      /// connues, écrite à l'identique (audit #151, ticket #163). Un
      /// `superadmin` ou un `admin ` n'ouvrait rien ici, mais le serveur lisait
      /// le second en retirant les espaces (`readRole`, `security/roles.ts`, lit
      /// désormais à l'identique). Même liste que `KNOWN_ROLES` et que
      /// l'énumération `UserRole` côté Dart.
      function updatedTypesOk() {
        return (!changes('last_seen_at')
                  || request.resource.data.get('last_seen_at', null) is timestamp)
          && (!changes('display_name')
                  || request.resource.data.get('display_name', null) is string)
          && (!changes('role')
                  || request.resource.data.get('role', null)
                       in ['pending', 'reader', 'editor', 'admin'])
          && (!changes('is_revoked') || request.resource.data.get('is_revoked', null) is bool);
      }

      /// Les champs que le titulaire change lui-même : sa connexion
      /// (`_upsertUser` : `last_seen_at`, `photo_url`, `display_name`), son
      /// nom préféré, sa couverture « Recette libre » et le défaut
      /// d'extraction des illustrations (`UserPreferencesRepository`). Ni
      /// `uid`, ni `email`, ni `role`, ni `is_revoked`, ni `created_at`.
      function ownerKeysOk() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'last_seen_at', 'photo_url', 'display_name', 'preferred_name',
                 'free_recipe_cover_url', 'import_illustrations']);
      }

      /// Ce qu'un administrateur change sur le compte d'un autre : le rôle,
      /// la révocation et le nom préféré (écran Admin › Comptes). Sur son
      /// propre compte, il a en plus les champs du titulaire.
      function adminKeysOk() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'role', 'is_revoked', 'preferred_name']);
      }

      /// À la création, les deux noms sont bornés.
      function namesBounded() {
        return nameOk('display_name') && nameOk('preferred_name');
      }

      /// À la mise à jour, seul un nom modifié est contrôlé : un document
      /// antérieur à la borne, au nom Google plus long, reste modifiable
      /// (rôle, dernière visite) sans qu'on touche à son nom.
      function touchedNamesBounded() {
        let keys = request.resource.data.diff(resource.data).affectedKeys();
        return (!keys.hasAny(['display_name']) || nameOk('display_name'))
               && (!keys.hasAny(['preferred_name']) || nameOk('preferred_name'));
      }

      // Le document d'un compte porte son adresse, son rôle et sa révocation :
      // il ne se lit que par son titulaire et par un administrateur. Les
      // écrans qui affichent le nom d'un autre membre lisent
      // `user_profiles/{uid}`, la projection publique tenue par le serveur
      // (v0.23.14). Un éditeur lisait auparavant tous les comptes, adresses
      // comprises, pour afficher un prénom (audit 2026-10-09).
      allow read: if isOwner(uid) || isAdmin();

      // L'adresse recopiée doit être vérifiée par le fournisseur d'identité
      // (`email_verified`, toujours vrai pour un compte Google) : le document
      // porte l'adresse sur laquelle se décident l'invitation par e-mail et
      // la reconnaissance du fondateur.
      allow create: if isAuthenticated() && request.auth.uid == uid
                      && request.resource.data.role == 'pending'
                      && request.resource.data.is_revoked == false
                      && request.resource.data.email == request.auth.token.email
                      && request.auth.token.email_verified == true
                      && createdKeysOk()
                      && namesBounded()
                      && photoUrlOk()
                      && coverUrlOk();

      // Un administrateur nomme et révoque — sauf le fondateur, que lui seul
      // peut destituer. Sans cette réserve, un administrateur adoubé pouvait
      // mettre dehors celui qui l'avait nommé.
      //
      // Chaque branche dit les champs qu'elle touche (`affectedKeys().hasOnly`) :
      // `uid` n'est dans aucune liste, et ne change donc plus après la
      // création (ticket #162).
      allow update: if !touchesEmail()
                      && touchedNamesBounded()
                      && updatedTypesOk()
                      && (!request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['free_recipe_cover_url'])
                          || coverUrlOk())
                      && (!request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['photo_url'])
                          || photoUrlOk())
                      && ((isAdmin() && adminKeysOk()
                           && (!touchesAuthority() || !targetIsFounder() || isFounder()))
                          || (isAuthenticated() && request.auth.uid == uid
                              && ownerKeysOk()
                              && !touchesAuthority()));

      allow delete: if isAdmin() && !targetIsFounder();

      // Préférences nutrition persistées par utilisateur/recette. Écrire
      // demande un compte nommé et non révoqué (`isApproved`), comme le reste
      // de l'application : un compte `pending` ou révoqué ne remplit plus son
      // espace (ticket #153). La lecture reste à son propriétaire.
      match /nutrition_portion_overrides/{recipeId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if (isOwner(uid) && isApproved()) || isAdmin();
      }

      // Préférences d'affichage — dont `book_order`, le rangement de la
      // bibliothèque. Ce sont des choix de lecteur : ils n'appartiennent qu'à
      // leur propriétaire, et n'existent pas dans les documents partagés.
      //
      // `planning_refusals` — la mémoire des refus du planning — est lue par
      // `suggestMealPlanFn` pour pondérer la présélection : sa forme est
      // bornée ici (`entries` en carte, 300 entrées au plus), comme le client
      // l'écrit (`PlanningRefusalsRepository`).
      //
      // Écrire demande un compte nommé et non révoqué (`isApproved`), et un
      // identifiant que le client écrit réellement (`knownPreferenceIds`) :
      // un compte `pending` ou révoqué ne remplissait pas moins son espace de
      // documents aux noms de son choix (ticket #153). La lecture reste à son
      // propriétaire. `planning_constraints` (v0.24.19, préférences comprises,
      // écrit par le serveur seul) recopie les textes de `planning_config`,
      // que l'administrateur ne lit pas : il ne le lit pas non plus.
      match /preferences/{prefId} {
        allow read: if isOwner(uid)
          || (isAdmin() && prefId != 'planning_constraints');
        allow delete: if (isOwner(uid) && isApproved()) || isAdmin();
        allow create, update: if ((isOwner(uid) && isApproved()) || isAdmin())
          && prefId in knownPreferenceIds()
          && (prefId != 'planning_refusals'
              || isPlanningRefusals(request.resource.data))
          && (prefId != 'explore_filters'
              || isExploreFilters(request.resource.data))
          && (prefId != 'planning_visibility'
              || isPlanningVisibility(request.resource.data));
      }

      // Appareils Android d'un administrateur, destinataires de la notification
      // de nouvelle version (`releaseNotificationSchedule`). Un jeton FCM est
      // écrit par son titulaire, et seulement tant qu'il est administrateur ;
      // il peut le supprimer tant qu'il est connecté. Un jeton resté après une
      // déconnexion ne sert à rien : le serveur ne lit que ceux des comptes
      // administrateurs au moment de l'envoi. Jamais lu par le client : le serveur
      // (SDK Admin) relit le rôle de chaque compte à l'envoi.
      match /devices/{token} {
        allow read: if false;
        allow create, update: if isOwner(uid) && isAdmin()
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updated_at'])
          && request.resource.data.token == token
          && token.size() <= 500
          && request.resource.data.platform == 'android'
          && request.resource.data.updated_at is timestamp;
        allow delete: if isOwner(uid);
      }

      // Générations de planning : journal des propositions, compteur des
      // conceptions et coût cumulé d'une génération. Écrites par le serveur
      // seul (`suggestMealPlanFn`, `generateRecipeConceptFn`) : le compteur
      // borne les conceptions facturées, un client qui l'écrirait remettrait
      // son plafond à zéro. Le titulaire ne les lit pas — l'écran n'en a pas
      // besoin ; l'administrateur les lit pour l'audit des coûts.
      match /planning_runs/{runId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      // ── Panier de courses personnel (`users/{uid}/shopping/current`) ──────
      //
      // Un seul document par compte, le même sur tous ses appareils. Il ne se
      // lit et ne s'écrit que par son titulaire nommé ; un administrateur n'y
      // a pas accès : ce qu'un membre achète ne regarde que lui.
      // Les produits ajoutés depuis le planning d'un autre membre vont dans le
      // panier de celui qui ajoute (`ShoppingCartRepository`).
      //
      // Forme bornée : `items` est une carte d'au plus 300 articles, et rien
      // d'autre que `items` et `updated_at`. Les règles ne parcourent pas une
      // carte : la longueur de chaque champ d'un article est bornée par le
      // client (`ShoppingItem.toFirestore`), le document entier par la limite
      // de 1 Mio de Firestore.
      match /shopping/{docId} {
        function isShoppingCart(data) {
          return data.keys().hasOnly(['items', 'updated_at'])
            && data.items is map
            && data.items.size() <= 300
            && (!('updated_at' in data) || data.updated_at is timestamp);
        }

        allow read, delete: if docId == 'current'
          && isOwner(uid) && isApproved();
        allow create, update: if docId == 'current'
          && isOwner(uid) && isApproved()
          && isShoppingCart(request.resource.data);
      }
    }

    // Profils publics : la part d'un compte que les autres membres voient.
    //
    // `user_profiles/{uid}` ne porte que le nom (`display_name`,
    // `preferred_name`) et la couverture « Recette libre »
    // (`free_recipe_cover_url`) — jamais l'adresse, le rôle ni la révocation.
    // Seul le serveur l'écrit : `syncUserClaims` le recopie de `users/{uid}`
    // à chaque écriture (le fonds existant a été semé en v0.23.14).
    // Un compte en attente n'a pas de profil.
    match /user_profiles/{uid} {
      allow read: if isApproved();
      allow write: if false;
    }

    // ── Confidentialité et propriété des livres et des recettes ─────────────
    //
    // Décisions de l'utilisateur (2026-10-09) :
    //  • un document privé (`is_private == true`) ne se lit que par son
    //    créateur — et par un administrateur, qui voit tout ;
    //  • on ne modifie et ne supprime que ses propres livres et recettes,
    //    éditeur compris ; l'administrateur agit comme le créateur ;
    //  • `created_by` vaut l'appelant à la création et ne change plus
    //    ensuite, administrateur compris : c'est le compte auquel les
    //    déclencheurs imputent la dépense d'IA d'une recette.
    //
    // Auparavant la confidentialité ne vivait que dans les requêtes du client :
    // un compte qui interrogeait Firestore directement lisait les livres et
    // recettes privés des autres, et leurs annotations. Et un lecteur pouvait
    // vider `created_by` de sa propre recette pour faire tourner les
    // déclencheurs nutrition hors de tout plafond.
    //
    // Un document n'est partagé que s'il porte `is_private == false`. Les
    // règles ne lisent pas ce champ par `get('is_private', false)` : dans une
    // requête, une valeur par défaut n'est pas prouvée par les filtres — une
    // liste sans filtre de confidentialité serait passée. Le champ est posé à
    // la création (client et serveur). Le fonds antérieur l'a reçu par deux
    // reprises lancées en production puis retirées du code : « Reprendre la
    // confidentialité » pour les recettes, `backfillBookPrivacyFn` pour les
    // livres (v0.23.8, retirée en v0.23.14).
    // Un document qui ne le porte pas reste lisible par son créateur et par un
    // administrateur.
    //
    // Les requêtes du client filtrent `is_private == false` ou
    // `created_by == uid` : c'est ce qui permet à ces règles de prouver chaque
    // résultat, sans quoi Firestore refuse la requête entière.

    function isSharedDoc(data) {
      return data.is_private == false;
    }

    function isCreator(data) {
      return isAuthenticated() && data.created_by == request.auth.uid;
    }

    /// `created_by` inchangé par l'écriture en cours.
    function keepsCreator() {
      return request.resource.data.get('created_by', null)
        == resource.data.get('created_by', null);
    }

    // ── Cloisonnement par groupe familial ───────────────────────────────────
    //
    // Décision de l'utilisateur (2026-10-10) : un groupe familial est un lieu
    // de partage. Un livre ou une recette non privé d'un autre compte ne se
    // lit que si ce compte partage au moins un groupe avec moi. Un compte qui
    // sort d'un groupe est traité comme s'il était supprimé. L'administrateur
    // voit tout, comme avant.
    //
    // Les règles ne peuvent pas parcourir `groups` pour répondre à « partage
    // un groupe avec moi ». `group_reach/{uid}` porte la réponse toute faite :
    // `uids`, la liste des autres comptes avec qui `uid` partage un groupe.
    // Seul le serveur l'écrit (déclencheur `syncGroupReach` sur
    // `groups/{groupId}`).
    //
    // Une requête du client reste prouvable : elle filtre
    // `created_by in [...]` sur des comptes de sa propre portée, et la règle
    // vérifie chaque valeur contre la liste. Une lecture facturée de plus par
    // requête, pas par document.
    //
    // Sans document de portée (compte sans groupe), on ne lit rien des
    // autres.
    function sharesGroupWith(ownerUid) {
      return ownerUid is string
        && exists(/databases/$(database)/documents/group_reach/$(request.auth.uid))
        && ownerUid in get(/databases/$(database)/documents/group_reach/$(request.auth.uid))
             .data.get('uids', []);
    }

    /// Un document partagé, et d'un compte de mes groupes.
    function isSharedWithMe(data) {
      return isSharedDoc(data) && sharesGroupWith(data.get('created_by', null));
    }

    /// Lecture d'une recette. Un brouillon partagé reste lisible par un
    /// éditeur de mes groupes (relecture) ; une recette privée, jamais par un
    /// autre que son créateur ou un administrateur.
    function canReadRecipe(data) {
      return isApproved() && (
        isCreator(data)
        || isAdmin()
        || ((data.review_status == 'validated' || isEditor()) && isSharedWithMe(data))
      );
    }

    function recipeDoc(recipeId) {
      return get(/databases/$(database)/documents/recipes/$(recipeId)).data;
    }

    // Collection books
    match /books/{bookId} {
      // Les quatre livres système se reconnaissent à leur tag interne. Ils se
      // renomment — c'est le titre que l'utilisateur voit — mais ne se
      // suppriment pas : ce sont les destinations par défaut des recettes sans
      // livre, des créations de l'IA et des recettes importées depuis un lien
      // (« Mes recettes du web », `__web`, créé par le serveur à l'ouverture de
      // la bibliothèque par `ensureWebBookFn`, le premier import restant un
      // filet). Les perdre laisserait des recettes
      // sans porteur, et la règle « toute recette a un livre » sans issue.
      //
      // La garde vit aussi dans l'écran et dans le repository ; ici seulement,
      // elle ne se contourne pas.
      function systemTags() {
        return ['__libres', '__kassdale_ia', '__secretes', '__web'];
      }

      function isSystemBook(data) {
        return data.tags is list && data.tags.hasAny(systemTags());
      }

      /// Une mise à jour garde chaque tag système que le livre portait.
      ///
      /// Sans ce contrôle, la protection se contournait en deux écritures :
      /// retirer le tag, puis supprimer le livre devenu ordinaire (audit
      /// sécurité, « Faible »). Le propriétaire comme l'administrateur
      /// renomment le livre ; aucun ne lui retire son tag.
      function keepsSystemTags() {
        return !isSystemBook(resource.data)
          || (request.resource.data.get('tags', null) is list
              && request.resource.data.tags.toSet().hasAll(
                   resource.data.tags.toSet().intersection(systemTags().toSet())));
      }

      /// L'identifiant fixe d'un livre système du compte appelant.
      function ownSystemBookId() {
        return bookId in ['kassdalle_' + request.auth.uid, 'libres_' + request.auth.uid,
                          'secretes_' + request.auth.uid];
      }

      allow read: if isApproved()
        && (isCreator(resource.data) || isAdmin() || isSharedWithMe(resource.data));
      // Son propre livre système encore absent se lit : le client le crée en
      // transaction (`_createSystemBook`), qui lit avant d'écrire. Sans cette
      // lecture, la règle ci-dessus échoue sur `resource == null`.
      allow get: if isEditor() && resource == null && ownSystemBookId();
      // « Mes recettes du web » est créé par le serveur seul, sous `web_{uid}`
      // (`ensureWebBookFn` à l'ouverture de la bibliothèque ; le premier import
      // par lien reste un filet).
      // Un client qui créait `web_{uid d'un autre}`, public, à son nom, y
      // faisait tomber les brouillons importés de cet autre compte. `web2_{uid}`
      // est le repli du serveur quand `web_{uid}` est occupé : même interdit.
      // Les trois autres livres système sont créés par le client
      // (`ensureSystemBooks`) et par le serveur (`ensureSystemBooksFor`, à
      // l'approbation du compte), sous un identifiant fixe :
      // `kassdalle_{uid}`, `libres_{uid}`, `secretes_{uid}`. Seul le compte
      // qu'il nomme le crée : un éditeur qui occupait `libres_{uid d'un autre}`
      // à son nom empêcherait le serveur de créer le livre de cet autre compte.
      allow create: if isEditor() && request.resource.data.created_by == request.auth.uid
        && !bookId.matches('web[0-9]*_.*')
        && (!bookId.matches('(kassdalle|libres|secretes)_.*') || ownSystemBookId())
        && !(request.resource.data.get('tags', []) is list
             && request.resource.data.get('tags', []).hasAny(['__web']));
      allow update: if isEditor() && (isCreator(resource.data) || isAdmin()) && keepsCreator()
        && keepsSystemTags();
      allow delete: if isEditor() && (isCreator(resource.data) || isAdmin())
        && !isSystemBook(resource.data);
    }

    // Collection recipes
    match /recipes/{recipeId} {
      // Le livre d'une recette, contrôlé à toute écriture qui pose ou change
      // `book_id` (et, pour la seule confidentialité, à celle qui change
      // `is_private`). Un seul `get()` du livre par écriture.
      //
      //  • Propriété (décision de l'utilisateur, v0.23.8) : on ne range une
      //    recette que dans SES livres — l'administrateur partout. Le livre
      //    doit exister. Une page d'autrui déjà rangée dans un livre y reste :
      //    une écriture qui ne change pas `book_id` n'est pas contrôlée ici.
      //  • Confidentialité : la recette porte celle de son livre. Une recette
      //    créée ou déplacée dans un livre privé avec `is_private: false`
      //    restait lisible par la famille jusqu'au passage de
      //    `syncRecipePrivacy`.
      //
      // Sans livre (`book_id` absent, nul ou vide) : rien à vérifier ; une
      // recette sans livre garde la confidentialité qu'elle porte. Un « / »
      // dans `book_id` viserait un autre document que le livre : refusé.
      function bookAccepts(book, checkOwner) {
        return book != null
          && (!checkOwner || isAdmin() || book.data.get('created_by', null) == request.auth.uid)
          && request.resource.data.get('is_private', false) == book.data.get('is_private', false);
      }

      function bookCheck(checkOwner) {
        let bookId = request.resource.data.get('book_id', null);
        // `book_id` est nul ou une chaîne : un autre type (nombre, liste) est
        // refusé plutôt que traité comme « sans livre ».
        return bookId == null
          || (bookId is string && (bookId == ''
          || (!bookId.matches('.*/.*')
              && exists(/databases/$(database)/documents/books/$(bookId))
              && bookAccepts(get(/databases/$(database)/documents/books/$(bookId)), checkOwner))));
      }

      function changes(field) {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny([field]);
      }

      // Adresse de la page d'origine d'une recette importée depuis un lien.
      // Le serveur l'écrit (`recipeProcessor`) ; le client ne la pose qu'en
      // recopiant celle de la recette qu'il copie (`source_recipe_id`) — c'est
      // elle que le contrôle du doublon compare. Une adresse inventée ferait
      // refuser à tort l'import d'une page jamais importée.
      //
      // La recette copiée doit aussi être lisible par l'appelant : sans cela,
      // une adresse se vérifiait contre une recette privée d'autrui, et la
      // création confirmait ou infirmait ce qu'elle contient. `source_site`, le
      // nom du site écrit à côté, et `source_author`, l'auteur annoncé par la
      // page, suivent la même règle.
      function sourceUrlAccepted() {
        let url = request.resource.data.get('source_url', null);
        let site = request.resource.data.get('source_site', null);
        let author = request.resource.data.get('source_author', null);
        let from = request.resource.data.get('source_recipe_id', null);
        return (url == null && site == null && author == null)
          || (from is string && from != '' && !from.matches('.*/.*')
              && exists(/databases/$(database)/documents/recipes/$(from))
              && canReadRecipe(get(/databases/$(database)/documents/recipes/$(from)).data)
              && get(/databases/$(database)/documents/recipes/$(from)).data.get('source_url', null) == url
              && get(/databases/$(database)/documents/recipes/$(from)).data.get('source_site', null) == site
              && get(/databases/$(database)/documents/recipes/$(from)).data.get('source_author', null) == author);
      }

      // Nutrition annoncée par la page d'une recette importée, et son écart
      // avec le calcul : le serveur seul les écrit (`recipeProcessor`,
      // `computeAndPersistRecipeNutrition`). Une copie ne les reprend pas.
      function serverOnlySourceFields() {
        return ['source_nutrition', 'source_nutrition_check'];
      }

      // Compteurs de tentatives des reprises automatiques : le rattrapage de
      // la nutrition (`nutrition_catch_up_attempts`) et la mémoire des échecs
      // du backfill « Rôle des recettes » (`meal_role_failure_count`,
      // `meal_role_attempt_at`). Écrits par le serveur seul : un créateur qui
      // les remettrait à zéro relancerait des appels de modèle facturés.
      function serverOnlyRetryFields() {
        return ['nutrition_catch_up_attempts', 'meal_role_failure_count', 'meal_role_attempt_at'];
      }

      // Allergènes de la recette, déduits par le serveur seul des ingrédients
      // du référentiel (`onRecipeWritten`, backfill « Allergènes ») ; leur date
      // de calcul vit dans le champ (`allergens.computed_at`). Le client ne les
      // pose pas à la création et ne les change ni ne les efface ensuite,
      // administrateur compris : une liste inventée afficherait sur la fiche
      // une absence d'allergène que personne n'a vérifiée.
      function serverOnlyComputedFields() {
        return ['allergens'];
      }

      // Marque « doublon possible » d'un brouillon issu d'un livre entier :
      // posée par le serveur seul (`recipeProcessor`). Le client ne peut que
      // l'effacer, en validant — jamais la poser ni la changer, ce qui ferait
      // écarter de la validation en lot un brouillon qui n'est pas un doublon.
      function duplicateMarkKeptOrRemoved() {
        return !changes('duplicate_of') || !('duplicate_of' in request.resource.data);
      }

      allow read: if canReadRecipe(resource.data);

      // Création : éditeur et administrateur, toujours à leur propre nom. Le
      // lecteur ne crée aucune recette — ni saisie, ni copie, ni création par
      // l'IA, ni import (refonte de l'écran Explorer, lot 2). Ses recettes
      // existantes restent les siennes : la mise à jour et la suppression
      // ci-dessous ne demandent que d'en être le créateur. Le serveur (Admin
      // SDK) écrit hors de ces règles.
      //
      // `estimated_times` (durées estimées par l'IA) s'écrit par le serveur
      // seul (`onRecipeWritten`, backfill « Durées estimées ») : ni posé à la
      // création, ni changé ni effacé par une mise à jour. Une durée saisie à
      // la main le retire par le serveur, qui le vide (prep et cook à null,
      // empreinte gardée) quand les deux durées sont lues.
      allow create: if isEditor() && request.resource.data.created_by == request.auth.uid
        && !('estimated_times' in request.resource.data)
        && !('duplicate_of' in request.resource.data)
        && !request.resource.data.keys().hasAny(serverOnlySourceFields())
        && !request.resource.data.keys().hasAny(serverOnlyRetryFields())
        && !request.resource.data.keys().hasAny(serverOnlyComputedFields())
        && bookCheck(true) && sourceUrlAccepted();

      // Mise à jour et suppression : le créateur ou un administrateur.
      allow update: if isApproved() && (isCreator(resource.data) || isAdmin()) && keepsCreator()
        && !changes('source_url') && !changes('source_site') && !changes('source_author')
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOnlySourceFields())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOnlyRetryFields())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOnlyComputedFields())
        && !changes('estimated_times')
        && duplicateMarkKeptOrRemoved()
        && ((changes('book_id') && bookCheck(true))
            || (!changes('book_id') && (!changes('is_private') || bookCheck(false))));
      allow delete: if isApproved() && (isCreator(resource.data) || isAdmin());

      // Annotations : tout compte nommé qui voit la recette en lit et en pose ;
      // seuls l'auteur et un administrateur les modifient ou les suppriment.
      // L'auteur relit toujours la sienne, même si la recette a cessé de lui
      // être visible.
      match /annotations/{annotationId} {
        allow read: if isApproved()
          && (isOwner(resource.data.uid) || canReadRecipe(recipeDoc(recipeId)));
        allow create: if isApproved() && request.resource.data.uid == request.auth.uid
          && canReadRecipe(recipeDoc(recipeId));
        allow update: if isApproved() && (isOwner(resource.data.uid) || isAdmin())
          && request.resource.data.uid == resource.data.uid;
        allow delete: if isApproved() && (isOwner(resource.data.uid) || isAdmin());
      }

      // Texte d'origine d'une recette traduite à l'import : lu avec les droits
      // de la recette, écrit seulement par le serveur (`recipeProcessor`), et
      // retiré avec elle par `onRecipeWritten`.
      match /origine/{docId} {
        allow read: if isApproved() && canReadRecipe(recipeDoc(recipeId));
        allow write: if false;
      }
    }

    // Notes de recettes (recipe_ratings) — même confidentialité que la
    // recette notée, lue par `get()` sur `recipe_id`.
    match /recipe_ratings/{ratingId} {
      // Forme d'une note. Toute la famille décode les notes d'une recette :
      // une seule note mal formée ferait échouer l'affichage chez tous.
      function isValidRating(data) {
        return data.keys().hasOnly(['user_id', 'recipe_id', 'rating', 'updated_at'])
          && data.rating is int && data.rating >= 0 && data.rating <= 10
          && data.updated_at is timestamp;
      }
      allow read: if isApproved() && (isOwner(resource.data.user_id)
        || canReadRecipe(recipeDoc(resource.data.recipe_id)));
      allow create: if isApproved() && request.resource.data.user_id == request.auth.uid
        && canReadRecipe(recipeDoc(request.resource.data.recipe_id))
        && ratingId == request.auth.uid + '_' + request.resource.data.recipe_id
        && isValidRating(request.resource.data);
      // `user_id` et `recipe_id` sont figés : l'identifiant du document les
      // contient tous les deux, et la création le vérifie. Une note par
      // membre et par recette : un doublon compterait deux fois dans la
      // moyenne de la famille.
      allow update: if isApproved() && (isOwner(resource.data.user_id) || isAdmin())
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.get('recipe_id', null) == resource.data.get('recipe_id', null)
        && isValidRating(request.resource.data);
      allow delete: if isApproved() && (isOwner(resource.data.user_id) || isAdmin());
    }

    // Portée des groupes : les comptes avec qui `uid` partage un groupe.
    // Lue par son titulaire (le client en tire ses requêtes) et par un
    // administrateur. Écrite par le serveur seul : un compte qui pourrait
    // s'ajouter la portée d'un autre lirait ses livres.
    match /group_reach/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // Groupes familiaux
    //
    // Être membre d'un groupe ouvre la lecture des livres et recettes non
    // privés des autres membres, dans les deux sens (`group_reach`). On n'y
    // entre donc que de son propre chef (décision de l'utilisateur,
    // 2026-10-10) : le propriétaire INVITE (`invited_ids`), l'invité accepte
    // ou refuse. Auparavant le propriétaire écrivait directement
    // `member_ids` : n'importe quel compte créait un groupe, y ajoutait un
    // inconnu, et lisait ses livres.
    //
    // Créer un groupe et le gérer demandent le rôle éditeur (v0.23.54) : un
    // lecteur rejoint un groupe sur invitation, il n'en ouvre pas. Un groupe
    // créé par un lecteur avant cette version reste lisible ; son
    // propriétaire peut encore le réduire (annuler une invitation, retirer un
    // membre) et le supprimer, mais plus le renommer ni y inviter.
    //
    // Cinq écritures, et elles seules :
    //  • gestion (propriétaire éditeur, ou administrateur) : renommer,
    //    inviter, annuler une invitation, retirer un membre — jamais en
    //    ajouter un ;
    //  • réduction (propriétaire, quel que soit son rôle) : annuler une
    //    invitation, retirer un membre — ni renommer, ni inviter ;
    //  • accepter (l'invité) : passer de `invited_ids` à `member_ids` ;
    //  • refuser (l'invité) : sortir de `invited_ids` ;
    //  • quitter (un membre autre que le propriétaire) : sortir de
    //    `member_ids`. La règle le refusait : « Quitter le groupe » échouait.
    match /groups/{groupId} {
      function oldMembers() {
        return resource.data.get('member_ids', []).toSet();
      }
      function newMembers() {
        return request.resource.data.get('member_ids', []).toSet();
      }
      function oldInvited() {
        return resource.data.get('invited_ids', []).toSet();
      }
      function newInvited() {
        return request.resource.data.get('invited_ids', []).toSet();
      }
      function onlyTouches(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }
      function me() {
        return [request.auth.uid].toSet();
      }

      /// Nom borné à 60 caractères, et 50 invitations en attente au plus.
      /// Chaque invité lit le groupe : sans borne, un compte poussait un
      /// texte de taille quelconque chez tous ceux qu'il invitait (revue
      /// sécurité v0.23.19).
      function boundedGroup(data) {
        return data.name is string && data.name.size() <= 60
          && data.get('invited_ids', []).size() <= 50;
      }

      /// Le propriétaire éditeur (ou un administrateur) gère le groupe sans y
      /// faire entrer personne : `member_ids` ne peut que perdre des comptes,
      /// le propriétaire y reste, et une invitation ne vise pas un compte déjà
      /// membre. Être propriétaire ne suffit pas : un lecteur propriétaire
      /// d'un groupe créé avant v0.23.54 n'y invite plus personne.
      function isManagement() {
        return ((isOwner(resource.data.owner_id) && isEditor()) || isAdmin())
          && onlyTouches(['name', 'member_ids', 'invited_ids'])
          && boundedGroup(request.resource.data)
          && oldMembers().hasAll(newMembers())
          && newMembers().hasAll([resource.data.owner_id])
          && !newInvited().hasAny(newMembers());
      }

      /// Le propriétaire, quel que soit son rôle, ne fait que réduire son
      /// groupe : `invited_ids` et `member_ids` ne perdent que des comptes, il
      /// reste membre, le nom ne change pas. Laisse au lecteur propriétaire
      /// d'un groupe antérieur à v0.23.54 de quoi en faire sortir quelqu'un.
      /// Sans doublon : `hasAll` compare des ensembles, et une liste répétée
      /// faisait grossir le document que chaque membre relit.
      function isShrinking() {
        return isOwner(resource.data.owner_id)
          && onlyTouches(['member_ids', 'invited_ids'])
          && boundedGroup(request.resource.data)
          && newMembers().size() == request.resource.data.member_ids.size()
          && newInvited().size() == request.resource.data.get('invited_ids', []).size()
          && oldMembers().hasAll(newMembers())
          && newMembers().hasAll([resource.data.owner_id])
          && oldInvited().hasAll(newInvited());
      }

      function isAcceptance() {
        return request.auth.uid in oldInvited()
          && onlyTouches(['member_ids', 'invited_ids'])
          && newMembers() == oldMembers().union(me())
          && newInvited() == oldInvited().difference(me());
      }

      function isRefusal() {
        return request.auth.uid in oldInvited()
          && onlyTouches(['invited_ids'])
          && newInvited() == oldInvited().difference(me());
      }

      function isLeaving() {
        return request.auth.uid in oldMembers()
          && request.auth.uid != resource.data.owner_id
          && onlyTouches(['member_ids'])
          && newMembers() == oldMembers().difference(me());
      }

      // L'invité lit le groupe pour décider : son nom et ses membres.
      allow read: if isApproved() &&
        (resource.data.owner_id == request.auth.uid
          || request.auth.uid in resource.data.member_ids
          || request.auth.uid in resource.data.get('invited_ids', []));
      // Les champs que `GroupRepository.createGroup` écrit, et `invited_ids`
      // vide : un champ libre (`description`…) serait relu par chaque invité.
      allow create: if isEditor()
        && request.resource.data.keys().hasOnly(
             ['name', 'owner_id', 'member_ids', 'invited_ids', 'created_at'])
        && request.resource.data.owner_id == request.auth.uid
        && request.resource.data.member_ids == [request.auth.uid]
        && request.resource.data.get('invited_ids', []).size() == 0
        && boundedGroup(request.resource.data);
      // `owner_id` est figé : changer de propriétaire n'est pas un parcours de
      // l'application, et un groupe offert à un autre compte lui en
      // attribuerait la gestion sans son accord.
      allow update: if isApproved()
        && request.resource.data.owner_id == resource.data.owner_id
        && (isManagement() || isShrinking() || isAcceptance() || isRefusal() || isLeaving());
      // La suppression reste ouverte au propriétaire quel que soit son rôle :
      // un lecteur propriétaire ne peut pas quitter son groupe (`isLeaving`),
      // et supprimer est sa seule façon d'en sortir.
      allow delete: if isApproved() && (isOwner(resource.data.owner_id) || isAdmin());
    }

    // app_config contient DEUX natures de documents :
    //  - `usage` : compteurs de scans et de stockage, écrits par le client ;
    //  - la politique nutrition, lue par les Cloud Functions comme autorité.
    // Ouvrir l'écriture à tout le monde laissait n'importe quel utilisateur
    // authentifié réécrire cette politique. L'écriture client est donc bornée
    // au seul document de compteurs.
    // `ai_pricing` se lit par tout utilisateur connecté : un prix public n'a
    // rien de confidentiel, et l'écran doit pouvoir annoncer ce que coûtera une
    // génération à celui qui la déclenche — pas seulement à un administrateur.
    // Son écriture reste réservée aux administrateurs, via la Cloud Function.
    // Le client écrit toujours exactement trois champs sur `usage` :
    // `storage_bytes`, `updated_at`, et un compteur mensuel nommé
    // dynamiquement (`scans_2026_10`). Un `hasOnly()` ne peut lister un nom
    // qui change chaque mois qu'en le construisant depuis la date du jour.
    // Le mois précédent est toléré en plus du mois courant, pour couvrir un
    // décalage d'horloge client autour d'un changement de mois. Sans cette
    // liste, un compte non-administrateur pouvait réécrire ce document avec
    // n'importe quel contenu, y compris falsifier les compteurs affichés.
    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }
    function scansKeyFor(y, m) {
      return 'scans_' + string(y) + '_' + pad2(m);
    }
    function currentScansKey() {
      return scansKeyFor(request.time.year(), request.time.month());
    }
    function previousScansKey() {
      return request.time.month() == 1
        ? scansKeyFor(request.time.year() - 1, 12)
        : scansKeyFor(request.time.year(), request.time.month() - 1);
    }

    // État et programmation des backfills (`backfill_run_<clé>`,
    // `backfill_schedules`) : écrits par le serveur seul, après contrôle de
    // forme (`setBackfillScheduleFn`, `setBackfillDoneFn`, `runBackfillPass`).
    // Un administrateur qui les écrirait directement pourrait programmer un
    // passage imputé au plafond d'un autre compte, ou lever un verrou.
    function isServerOnlyConfig(docId) {
      return docId == 'backfill_schedules' || docId.matches('backfill_run_.*')
        || docId == 'tickets_status' || docId == 'apk_notification';
    }

    match /app_config/{docId} {
      allow read: if isAdmin() ||
                     (isApproved() && (docId == 'usage' || docId == 'ai_pricing'
                                       || docId == 'tickets'));
      allow write: if (isAdmin() && !isServerOnlyConfig(docId)) || (
        isApproved() && docId == 'usage' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['storage_bytes', 'updated_at', currentScansKey(), previousScansKey()])
        && countsUp('storage_bytes')
        && countsUp(currentScansKey())
        && countsUp(previousScansKey())
      );
    }

    /// Un compteur de `app_config/usage` écrit par le client reste un entier
    /// positif qui ne recule pas. Le client n'écrit que des incréments
    /// (`FieldValue.increment`) ; les règles voient la valeur résultante.
    /// Sans ce contrôle, la liste de champs bornait les noms, pas les
    /// valeurs : un compte nommé remettait les compteurs à zéro ou les
    /// rendait négatifs (audit sécurité, « Faible »). Un champ absent de
    /// l'écriture n'est pas contrôlé.
    function countsUp(field) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is int
            && request.resource.data[field] >= 0
            && request.resource.data[field] >= resource.data.get(field, 0));
    }

    // Configurations de routage enregistrées.
    //
    // Écriture SERVEUR uniquement : `aiRoutingPresetsFn` contrôle la
    // configuration contre le catalogue de postes du jour avant de l'écrire.
    // Une configuration écrite directement par le client échapperait à ce
    // contrôle, et se chargerait ensuite amputée sans que personne sache
    // pourquoi.
    //
    // Lecture ouverte à l'administrateur pour l'inspection. L'écran, lui,
    // passe par la Cloud Function, qui relit chaque configuration contre le
    // catalogue et dit ce qu'elle a écarté.
    match /ai_routing_presets/{presetId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Jobs de traitement IA
    //
    // Le traitement se fait entièrement côté backend (Cloud Tasks). Le client
    // ne fait plus que deux choses sur un job existant : le relancer et
    // l'annuler. Il n'a donc plus à pouvoir écrire le résultat du traitement —
    // l'écriture lui était ouverte en grand du temps où il traitait lui-même.
    match /processing_jobs/{jobId} {
      function isJobOwner() {
        return isAuthenticated() && resource.data.created_by == request.auth.uid;
      }

      // Champs qu'une relance ou une annulation touche, et eux seuls.
      function touchesOnlyRetryOrCancelFields() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'error_message', 'current_step', 'cancel_requested',
          'created_recipe_ids', 'created_book_id', 'updated_at', 'url_retry_count'
        ]);
      }

      // Import par lien : chaque relance relance le pipeline facturé, hors du
      // plafond quotidien que la callable a compté une fois. Elle n'est donc
      // admise que sur un job en erreur passagère — délai dépassé, ou échec
      // sans code (incident du pipeline, annulation) —, et deux fois au plus :
      // le client incrémente `url_retry_count` d'exactement un, la règle borne
      // à 2. Un job terminé ou refusé par le site ne se relance pas.
      function isUrlImport() {
        return resource.data.get('type', 'recipeScan') == 'recipeUrlImport';
      }
      // Annuler un import par lien n'a de sens qu'en file ou en cours : annuler
      // un job terminé le ferait passer en erreur, donc relançable.
      function urlJobInFlight() {
        return resource.data.get('status', '') in ['queued', 'processing'];
      }
      // Une annulation ne touche pas au compteur de relances : sinon chaque
      // annulation le remettrait à zéro et la borne de 2 ne tiendrait plus.
      function retryCountUnchanged() {
        return request.resource.data.get('url_retry_count', 0)
          == resource.data.get('url_retry_count', 0);
      }
      function urlRelaunchAllowed() {
        let code = resource.data.get('error_code', null);
        let before = resource.data.get('url_retry_count', 0);
        return resource.data.get('status', '') == 'error'
          && (code == null || code == 'timeout')
          && request.resource.data.get('url_retry_count', 0) == before + 1
          && before + 1 <= 2;
      }

      // Pages supplémentaires d'un import : 20 au plus (21 pages avec la
      // première). Le pipeline télécharge chacune et l'envoie au modèle ; sans
      // borne, un job écrit hors de l'application pouvait en lister des
      // centaines (audit #151, ticket #156). La même borne vit dans
      // `MAX_ADDITIONAL_FILE_URLS` (pipeline/jobPages.ts) et
      // `kMaxAdditionalFileUrls` (processing_job.dart) ; un test de chaque côté
      // relit ce fichier pour vérifier que les trois valeurs concordent.
      function additionalFileUrlsBounded() {
        return !request.resource.data.keys().hasAny(['additional_file_urls'])
          || (request.resource.data.additional_file_urls is list
              && request.resource.data.additional_file_urls.size() <= 20);
      }

      // Un job se lit par son créateur et par un administrateur. L'éditeur
      // lisait ceux de tous les comptes (fichier envoyé, messages d'erreur) ;
      // aucun écran ne s'en servait : la file de travail d'un éditeur ne
      // liste que ses propres jobs, la vue de tous les jobs est réservée à
      // l'administrateur.
      allow read: if isAdmin() || isJobOwner();
      // Un job déclenche le pipeline (jobDispatcher), donc des appels d'IA
      // facturés : l'import est réservé aux éditeurs et aux administrateurs.
      // Un lecteur n'importe pas. Le job est toujours créé à son propre nom.
      //
      // Un import depuis un lien (`recipeUrlImport`) n'est créé que par
      // `importRecipeFromUrlFn`, qui vérifie l'adresse, le doublon et le
      // plafond du jour. Écrit par le client, il les contournerait tous.
      //
      // Le job naît en file, sans aucun champ que seul le pipeline écrit. Les
      // clés de titre et `duplicate_checked` servent de référence aux imports
      // suivants du même livre : posées par le client sur un job jamais mis en
      // file, elles arrêteraient ces imports au statut « Doublon possible ».
      allow create: if isEditor() && request.resource.data.created_by == request.auth.uid
        && request.resource.data.get('type', 'recipeScan') != 'recipeUrlImport'
        && request.resource.data.get('status', 'queued') == 'queued'
        && additionalFileUrlsBounded()
        && !request.resource.data.keys().hasAny([
             'titre_keys', 'titre_key_pages', 'titre_key_titres', 'duplicate_checked',
             'duplicates', 'pending_items', 'duplicate_override'
           ]);
      // Une relance remet le job en `queued`, et jobDispatcher relance alors le
      // pipeline facturé : elle suit le droit de création. Le propriétaire qui
      // n'est plus éditeur (job créé avant ce droit, compte rétrogradé) garde
      // l'annulation, et elle seule, sous la forme exacte qu'écrit `cancelJob` :
      // `status: 'error'` et `cancel_requested: true`. Exclure `queued` ne
      // suffisait pas : jobDispatcher met aussi en file un job dont le statut
      // est absent ou vide.
      function isExactCancel() {
        return request.resource.data.status == 'error'
          && request.resource.data.cancel_requested == true;
      }

      // « Ce n'est pas un doublon » : un import arrêté après sa transcription
      // (`status: 'duplicate'`) reprend au balisage. La reprise relance le
      // pipeline facturé : elle suit le droit de création. Elle ne touche pas
      // `created_recipe_ids` — les autres recettes de la page sont déjà des
      // brouillons — et pose `duplicate_override`, qui fait sauter la détection.
      function isDuplicateResume() {
        return resource.data.get('status', '') == 'duplicate'
          && request.resource.data.status == 'queued'
          && request.resource.data.duplicate_override == true
          && !isUrlImport()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'duplicate_override', 'error_message', 'current_step', 'updated_at'
             ]);
      }

      allow update: if additionalFileUrlsBounded()
                    && (isAdmin()
                        || (isJobOwner() && touchesOnlyRetryOrCancelFields()
                            && ((isExactCancel() && retryCountUnchanged()
                                 && (!isUrlImport() || urlJobInFlight()))
                                || (isEditor() && request.resource.data.status in ['queued', 'error']
                                    && resource.data.get('status', '') != 'duplicate'
                                    && (!isUrlImport() || urlRelaunchAllowed()))))
                        || (isJobOwner() && isEditor() && isDuplicateResume()));
      // Un import en attente de doublon se supprime par son propriétaire : rien
      // n'y tourne, et la ligne n'a pas d'autre sortie que la reprise. Un
      // statut 'duplicate' n'est posé que par le pipeline : la relance
      // ci-dessus n'admet que 'queued' ou 'error'.
      allow delete: if isAdmin()
                    || (isJobOwner() && isEditor() && resource.data.get('status', '') == 'duplicate');
    }

    // Suivi de l'usage des tokens IA
    //
    // Ces lignes sont écrites par les Cloud Functions (Admin SDK, hors de ces
    // règles) au moment où l'appel est passé — jamais par le client. La règle
    // de création lui était pourtant ouverte : n'importe quel compte pouvait
    // fabriquer des lignes de coût, et la réconciliation mensuelle les aurait
    // présentées comme des dépenses réelles. Un montant faux ne se voit pas.
    match /ai_usage/{docId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Dépense d'IA du jour, par compte — ce que le plafond relit avant chaque
    // appel. Écrite par les Cloud Functions au moment où le coût est connu ;
    // ouverte au client, elle laisserait remettre son propre compteur à zéro.
    match /ai_daily_spend/{docId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Imports par lien du jour, par compte — le compteur du plafond quotidien
    // d'`importRecipeFromUrlFn`. Écrit par les Cloud Functions ; ouvert au
    // client, il laisserait remettre son propre compteur à zéro.
    match /url_import_daily/{docId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Recherches web du jour, par compte — le compteur du plafond quotidien de
    // `searchWebRecipesFn`. Même règle que `url_import_daily` : écrit par les
    // Cloud Functions, lu par son titulaire.
    match /web_search_daily/{docId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Invitations par e-mail. Elles portent l'adresse d'une personne qui n'a
    // pas encore de compte, et décident du rôle qu'elle recevra à sa première
    // connexion : seul un administrateur les lit, et seules les Cloud
    // Functions les écrivent (`manageInvitationFn`, `applyEmailInvitation`).
    // Ouvertes à l'écriture, elles laisseraient un compte s'inviter lui-même
    // sous une autre adresse avec le rôle de son choix.
    //
    // Le propriétaire d'un groupe, admin ou non, lit les invitations de son
    // groupe : la feuille du groupe lui montre qui a été invité. Un membre
    // non propriétaire n'en lit aucune. La règle compare `group_owner_id`,
    // l'uid du propriétaire écrit par le serveur à la création de
    // l'invitation (`owner_id` d'un groupe est figé), et non le groupe
    // courant : un groupe supprimé puis recréé sous le même identifiant par
    // un autre compte lui ouvrait les invitations restées en base, adresses
    // comprises (ticket #152). Une invitation sans ce champ — antérieure à
    // v0.24.14 et pas encore reprise par le backfill « Propriétaire du groupe
    // des invitations » — n'est lisible que par un administrateur. La lecture
    // exige une requête filtrée sur `group_owner_id`.
    match /invitations/{invitationId} {
      allow read: if isAdmin()
        || (isApproved()
          && resource.data.get('group_owner_id', null) == request.auth.uid);
      allow write: if false;
    }

    // Envois d'invitations du jour, par administrateur — le compteur du
    // plafond de vingt envois. Écrit par les Cloud Functions seulement.
    match /invitation_sends_daily/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Recherches d'un membre par adresse du jour, par compte — le compteur du
    // plafond de dix recherches de `findMemberByEmailFn`. Écrit par les
    // Cloud Functions seulement, lu par personne côté client : ouvert en
    // écriture, il laisserait remettre son compteur à zéro et essayer des
    // adresses sans borne.
    match /member_email_search_daily/{docId} {
      allow read, write: if false;
    }

    // Cache partagé des recherches web (sept jours). Lu et écrit par les Cloud
    // Functions seulement : ouvert au client, il laisserait servir à toute la
    // famille des pages choisies par un seul compte, sans appel ni décompte.
    match /web_search_cache/{key} {
      allow read, write: if false;
    }

    // Dépense d'IA par scan — le compteur, et le plafond d'un import de livre.
    // Écrite par les Cloud Functions ; ouverte au client, elle laisserait relever
    // son propre plafond.
    match /scan_spend/{scanId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Plannings partagés (v0.23.47)
    //
    // Un éditeur ou un administrateur coche, dans ses préférences de
    // planning, les groupes familiaux qui voient son planning
    // (`planning_config/{uid}.shared_group_ids`). Le serveur en tire
    // `planning_reach/{lecteur}.uids` : les propriétaires dont ce compte lit
    // les repas, en lecture seule. Les règles ne peuvent ni parcourir les
    // groupes ni lire le rôle du propriétaire : elles lisent cette liste
    // toute faite (déclencheurs `syncGroupReach`, `syncPlanningReachOnConfig`
    // et `syncPlanningReachOnRole`).
    //
    // Une requête du client reste prouvable : elle filtre `uid == owner` sur
    // un seul propriétaire, et la règle vérifie la valeur contre la liste.
    // Un compte en attente ou révoqué ne lit aucun repas d'autrui.
    function canReadPlanningOf(ownerUid) {
      return ownerUid is string
        && isApproved()
        && exists(/databases/$(database)/documents/planning_reach/$(request.auth.uid))
        && ownerUid in get(/databases/$(database)/documents/planning_reach/$(request.auth.uid))
             .data.get('uids', []);
    }

    // Plannings de groupe
    //
    // Un repas dont `group_id` vaut un groupe appartient au planning de ce
    // groupe : son propriétaire (`owner_id`, éditeur ou administrateur) le
    // tient, tous les membres le lisent, un invité non. Le serveur pose dans
    // `planning_reach/{lecteur}.group_ids` les groupes ACTIFS dont ce compte
    // est membre, propriétaire compris ; un groupe dont le propriétaire est
    // rétrogradé en sort, et son planning n'est plus lu par personne, sans
    // être effacé.
    //
    // Une requête du client reste prouvable : elle filtre `group_id == X` et
    // `uid == propriétaire` sur un seul groupe, et la règle vérifie le groupe
    // contre la liste, puis que `uid` est le propriétaire ACTUEL du groupe :
    // un groupe supprimé puis recréé sous le même identifiant par un autre
    // compte n'ouvre pas aux nouveaux membres les repas de l'ancien
    // propriétaire.
    function canReadGroupPlanning(groupId) {
      return groupId is string
        && isApproved()
        && exists(/databases/$(database)/documents/planning_reach/$(request.auth.uid))
        && groupId in get(/databases/$(database)/documents/planning_reach/$(request.auth.uid))
             .data.get('group_ids', []);
    }

    /// Le repas écrit est personnel (`group_id` absent ou nul), ou d'un groupe
    /// dont l'appelant est le propriétaire. Une lecture du groupe par écriture
    /// d'un repas de groupe ; aucune pour un repas personnel.
    function ownsMealGroup(data) {
      return data.get('group_id', null) == null
        || (data.group_id is string
            && get(/databases/$(database)/documents/groups/$(data.group_id)).data.owner_id
                 == request.auth.uid);
    }

    // Repas planifiés
    //
    // Planifier est un geste d'éditeur (v0.23.47) : un lecteur, un compte en
    // attente ou révoqué ne crée, ne modifie ni ne supprime aucun repas. Il
    // relit ses repas antérieurs ; il les supprimait aussi, jusqu'au planning
    // de groupe. `uid` est figé : un repas offert à un autre compte
    // apparaîtrait dans son planning. `group_id` est figé aussi : un repas ne
    // change pas de planning. Les repas d'un planning partagé ou d'un groupe
    // se lisent ; seul leur propriétaire les écrit.
    match /planned_meals/{mealId} {
      // Le partage d'un planning personnel n'ouvre que ses repas personnels
      // (`group_id` nul) : les repas des groupes du propriétaire ne se lisent
      // que par les membres de ces groupes. La requête d'un planning partagé
      // filtre donc `uid == propriétaire` ET `group_id == null` ; un repas
      // personnel porte `group_id: null` explicite (le backfill « Portée des
      // groupes et des plannings » le pose sur les repas antérieurs).
      // `resource.data.group_id`, et non `.get('group_id', null)` : sur une
      // requête qui ne contraint pas `group_id`, la valeur par défaut rendrait
      // la condition vraie, et `uid == propriétaire` seul ramènerait ses
      // repas de groupe. Un champ absent fait échouer la condition.
      allow read: if isAuthenticated()
        && (resource.data.uid == request.auth.uid
            || (canReadPlanningOf(resource.data.uid)
                && resource.data.group_id == null)
            || (canReadGroupPlanning(resource.data.get('group_id', null))
                && resource.data.uid == get(/databases/$(database)/documents/groups/$(resource.data.group_id)).data.owner_id));
      allow delete: if isEditor() && resource.data.uid == request.auth.uid;
      allow create: if isEditor() && request.resource.data.uid == request.auth.uid
        && ownsMealGroup(request.resource.data);
      allow update: if isEditor() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.get('group_id', null) == resource.data.get('group_id', null)
        && ownsMealGroup(request.resource.data);
    }

    /// `shared_group_ids` de `planning_config` : une liste bornée. Les règles
    /// ne savent pas parcourir une liste pour en vérifier chaque élément ; le
    /// serveur ignore toute valeur qui n'est pas un identifiant de groupe.
    /// `group_portions` (parts par défaut de chaque groupe possédé) : une
    /// table bornée de la même façon.
    function isPlanningConfig(data) {
      return (!('shared_group_ids' in data)
          || (data.shared_group_ids is list && data.shared_group_ids.size() <= 50))
        && (!('group_portions' in data)
          || (data.group_portions is map && data.group_portions.size() <= 50));
    }

    // Préférences de planning — lues par leur titulaire, écrites par un
    // éditeur pour lui-même : le lecteur ne planifie plus.
    match /planning_config/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow create, update: if isEditor() && request.auth.uid == uid
        && isPlanningConfig(request.resource.data);
      allow delete: if isEditor() && request.auth.uid == uid;
    }

    // Portée des plannings : les comptes dont `uid` lit le planning. Lue par
    // son titulaire (le client en tire ses flux) et par un administrateur.
    // Écrite par le serveur seul : un compte qui pourrait s'ajouter la
    // portée d'un autre lirait ses repas.
    match /planning_reach/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // Suggestions de repas (v0.23.58)
    //
    // Un membre d'un groupe actif, autre que son propriétaire, lecteur
    // compris, suggère au propriétaire un plat pour un jour du planning du
    // groupe : une recette (`recipe_id` + son titre copié `recipe_titre`) ou
    // un nom libre (`free_title`), et un mot facultatif (`note`). Pas de
    // statut : le propriétaire lit, et planifie lui-même s'il retient l'idée.
    //
    // `group_owner_id` est dénormalisé et vérifié à la création contre
    // `groups/{group_id}.owner_id` (figé) : les deux requêtes du client
    // restent prouvables — `group_owner_id == moi` pour le propriétaire,
    // `author_uid == moi` pour l'auteur. Un autre membre ne lit pas les
    // suggestions des autres.
    //
    // Le titre d'une recette privée suggérée est copié dans la suggestion :
    // le propriétaire le lit, sans pouvoir ouvrir la fiche.
    //
    // Volume borné par la règle (revue sécurité v0.23.58) : l'identifiant est
    // imposé, `{group_id}_{auteur}_{day}_{n}` avec n de 0 à 4 — cinq
    // suggestions au plus par auteur, groupe et jour, une sixième tomberait
    // sur un identifiant existant, donc sur une mise à jour refusée. Le jour
    // (`AAAA-MM-JJ`) est une date réelle, dont la fin tombe au plus tôt un
    // jour avant l'heure du serveur (la veille UTC passe : elle couvre le
    // décalage entre le jour local de l'auteur et l'heure UTC), et dont le
    // début tombe au plus tard soixante jours après.
    //
    // Aucune mise à jour. L'auteur retire sa suggestion ; le propriétaire
    // peut aussi la supprimer. Le serveur supprime les suggestions d'un
    // groupe supprimé et celles d'un membre qui en sort (`syncGroupReach`).
    /// Le jour `AAAA-MM-JJ` de [day], à minuit UTC, après vérification de la
    /// forme. Une date impossible (mois 13, 30 février) fait échouer la
    /// comparaison de `isSuggestionDay`.
    function suggestionDate(day) {
      return timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10]));
    }

    function isSuggestionDay(day) {
      return day is string && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && int(day[5:7]) >= 1 && int(day[5:7]) <= 12
        && int(day[8:10]) >= 1 && int(day[8:10]) <= 31
        && suggestionDate(day).month() == int(day[5:7])
        && suggestionDate(day).day() == int(day[8:10])
        && suggestionDate(day) + duration.value(1, 'd') >= request.time - duration.value(1, 'd')
        && suggestionDate(day) <= request.time + duration.value(60, 'd');
    }

    /// Les cinq identifiants admis pour une suggestion de l'appelant :
    /// `{group_id}_{uid}_{day}_0` à `_4`.
    function suggestionIds(data) {
      let prefix = data.group_id + '_' + request.auth.uid + '_' + data.day + '_';
      return [prefix + '0', prefix + '1', prefix + '2', prefix + '3', prefix + '4'];
    }

    function isMealSuggestion(data) {
      return data.keys().hasOnly(['group_id', 'group_owner_id', 'author_uid', 'day',
                                  'recipe_id', 'recipe_titre', 'free_title',
                                  'note', 'created_at'])
        && data.keys().hasAll(['group_id', 'group_owner_id', 'author_uid', 'day',
                               'created_at'])
        && data.group_id is string && data.group_id.size() > 0
        && data.group_id.size() <= 128
        && data.group_owner_id is string
        && isSuggestionDay(data.day)
        && data.created_at == request.time
        && optText(data, 'note', 200)
        && ((('recipe_id' in data) && !('free_title' in data)
              && data.recipe_id is string && data.recipe_id.size() > 0
              && data.recipe_id.size() <= 128
              && data.recipe_titre is string && data.recipe_titre.size() > 0
              && data.recipe_titre.size() <= 200)
          || (('free_title' in data) && !('recipe_id' in data)
              && !('recipe_titre' in data)
              && data.free_title is string && data.free_title.size() > 0
              && data.free_title.size() <= 60));
    }

    match /meal_suggestions/{suggestionId} {
      // Groupe actif dont l'auteur est membre (`planning_reach.group_ids`,
      // propriétaire compris), membre présent dans le groupe lui-même — la
      // portée suit d'une seconde un départ —, et pas le propriétaire.
      allow create: if isApproved()
        && isMealSuggestion(request.resource.data)
        && suggestionId in suggestionIds(request.resource.data)
        && request.resource.data.author_uid == request.auth.uid
        && canReadGroupPlanning(request.resource.data.group_id)
        && request.resource.data.group_owner_id
             == get(/databases/$(database)/documents/groups/$(request.resource.data.group_id)).data.owner_id
        && request.resource.data.group_owner_id != request.auth.uid
        && request.auth.uid
             in get(/databases/$(database)/documents/groups/$(request.resource.data.group_id)).data.get('member_ids', []);
      allow read: if isApproved()
        && (resource.data.author_uid == request.auth.uid
            || resource.data.group_owner_id == request.auth.uid);
      allow update: if false;
      allow delete: if isApproved()
        && (resource.data.author_uid == request.auth.uid
            || resource.data.group_owner_id == request.auth.uid);
    }

    // Rapports d'erreur
    //
    // Un compte en attente en écrit : c'est à la première connexion, avant
    // tout rôle, qu'une panne a le plus besoin d'être vue. Un compte révoqué
    // n'en écrit plus : il remplirait la collection que l'administrateur lit.
    // La révocation se lit ici sans `getUserData()`, qui échoue tant que le
    // document du compte n'existe pas encore (première connexion).
    function isKnownRevoked() {
      return ('revoked' in request.auth.token && request.auth.token.revoked == true)
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && getUserData().get('is_revoked', false) == true);
    }

    /// Un champ texte facultatif : absent, nul, ou une chaîne de [max]
    /// caractères au plus.
    function optText(data, field, max) {
      return !(field in data) || data[field] == null
        || (data[field] is string && data[field].size() <= max);
    }

    /// Forme d'un rapport d'erreur, tel que l'écrit `ErrorReportService`
    /// (`ErrorReport.toFirestore`). Tout compte connecté, même en attente, en
    /// écrit : sans liste de champs ni borne, un rapport servait de stockage
    /// libre jusqu'au mégaoctet (audit sécurité, « Faible »). Les bornes
    /// valent le double de la troncature du client, qui ne perd donc aucun
    /// rapport ; le contexte est une chaîne JSON, que la règle peut mesurer.
    function isErrorReport(data) {
      return data.keys().hasOnly(['user_id', 'job_id', 'timestamp', 'app_version',
                                  'feature', 'error_type', 'error_message',
                                  'stack_trace', 'context'])
        && data.user_id == request.auth.uid
        && (!('timestamp' in data) || data.timestamp is timestamp)
        && optText(data, 'job_id', 400)
        && optText(data, 'app_version', 100)
        && optText(data, 'feature', 400)
        && optText(data, 'error_type', 400)
        && optText(data, 'error_message', 8000)
        && optText(data, 'stack_trace', 4000)
        && optText(data, 'context', 8000);
    }

    match /error_reports/{reportId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.user_id == request.auth.uid);
      allow create: if isAuthenticated() && !isKnownRevoked()
        && isErrorReport(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // Dead Letter Queue — uniquement administrable.
    // Écriture déléguée aux Cloud Functions (Admin SDK contourne ces règles).
    match /dead_letters/{dlqId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Réconciliation mensuelle IA (estimé vs facturé vs non attribué).
    match /ai_reconciliation_monthly/{periodId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Référentiel nutrition (per100g) : lu par le détail nutritionnel d'une
    // recette, donc par tout utilisateur, pas seulement l'admin. L'écriture
    // reste réservée aux Cloud Functions (Admin SDK, hors de ces règles).
    match /nutrition_ingredients/{ingredientId} {
      allow read: if isApproved();
      // Le référentiel s'écrit côté serveur. Deux exceptions : le produit
      // acheté et les allergènes, corrigés à la main par un administrateur
      // depuis Admin › Référentiels › Ingrédients — ces champs-là, et eux seuls.
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'shopping_product', 'shopping_product_source',
          'allergens', 'allergens_source', 'allergens_at', 'updated_at'
        ]) &&
        // Une liste de 14 clés au plus, signée « admin » : une valeur qui
        // n'est pas une liste remettrait l'ingrédient en « jamais examiné »,
        // et une source « ai_estimated » masquerait la correction manuelle.
        (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['allergens', 'allergens_source']) ||
          (request.resource.data.allergens is list &&
            request.resource.data.allergens.size() <= 14 &&
            request.resource.data.allergens_source == 'admin'));
      allow create, delete: if false;
    }

    // Référentiel des unités : source de vérité des conversions, lue par le
    // client comme par le backend. Administrable via l'écran Admin.
    match /nutrition_units/{unitId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // Garnitures simples : riz, pâtes, salade, yaourt — ce qui accompagne un
    // plat sans recette, avec la part par personne. Référentiel partagé par
    // la famille, tenu depuis Admin › Référentiels. Les retouches de chacun
    // vivent sous `users/{uid}/preferences/meal_staples`, jamais ici.
    match /meal_staples/{stapleId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // Tickets des membres (bugs, idées, questions publiés en Issues GitHub).
    //
    // Privés : l'auteur lit les siens, l'administrateur lit tout. Écrits par
    // les Cloud Functions seules (`submitTicket`, `attachTicketScreenshot`,
    // le webhook GitHub, la tâche horaire), avec une exception : l'auteur pose
    // `seen_by_author_at` en ouvrant le détail, ce champ seul, à l'heure du
    // serveur (`request.time`), pour éteindre le point de notification.
    // Un ticket absent se lit comme absent (`resource == null`) par un compte
    // approuvé : le détail affiche « Ce ticket n'existe plus » au lieu d'un
    // refus. Un identifiant aléatoire inexistant ne révèle rien.
    match /tickets/{ticketId} {
      allow read: if isAdmin()
        || (isApproved()
            && (resource == null || resource.data.author_uid == request.auth.uid));
      allow update: if isApproved()
        && resource.data.author_uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['seen_by_author_at'])
        && request.resource.data.seen_by_author_at == request.time;
      allow create, delete: if false;

      // Sous-documents privés d'un ticket (`admin/analysis` : analyses du
      // mainteneur relevées sur l'Issue). Écrits par les Functions seules ;
      // lus par l'administrateur seul, jamais par l'auteur du ticket.
      match /admin/{doc} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Compteurs du plafond quotidien des tickets : `submitTicket` les lit et
    // les incrémente dans sa transaction. Aucun accès client.
    match /ticket_quotas/{docId} {
      allow read, write: if false;
    }

    // Journal de modération des images.
    //
    // Un administrateur lit tout — c'est lui qui arbitre. Celui qui a envoyé
    // une image lit la sienne : sans cela, une image en attente disparaîtrait
    // sans un mot, ce qui est pire qu'un refus.
    //
    // Écriture SERVEUR uniquement : une décision de modération que le client
    // peut écrire n'est pas une décision.
    match /image_moderation/{moderationId} {
      allow read: if isAdmin() || (isApproved() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }
  }
}
