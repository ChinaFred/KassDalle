<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- INTERNET n'était déclarée que dans les manifestes debug/ et profile/.
         L'APK de release fonctionnait par effet de bord, la fusion des
         manifestes des plugins Firebase la réintroduisant. Elle est déclarée
         ici pour que ce soit une intention, pas une chance. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Kass'Dalle n'est pas sur le Play Store : elle se met à jour elle-même,
         en téléchargeant l'APK publié par le hosting puis en ouvrant
         l'installateur du système. Sans cette permission, Android refuse
         l'intent d'installation et l'utilisateur doit repasser par le
         navigateur et le gestionnaire de fichiers.

         Elle n'autorise pas à installer : elle autorise à le demander. Le
         système affiche toujours son écran de confirmation, et l'utilisateur
         doit avoir accordé « installer des applications inconnues » à
         Kass'Dalle au préalable. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:label="Kass\'Dalle"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- « Partager vers Kass'Dalle » : l'application apparaît dans la
                 feuille de partage du système pour un texte, ce qu'envoie un
                 navigateur qui partage une page. MainActivity lit ce texte et le
                 rend à Dart par le canal dev.kassbi.kass_dalle/share, qui en
                 tire l'adresse et ouvre la boîte « Importer depuis un lien »
                 (éditeurs et administrateurs). Ni image ni fichier : seul le
                 texte est déclaré.

                 launchMode reste singleTop. Un partage depuis une autre
                 application ouvre une instance dans la tâche de l'expéditeur
                 (onCreate lit le partage, « Retour » ramène au navigateur) ;
                 quand Kass'Dalle est déjà au premier plan, le partage arrive
                 par onNewIntent. singleTask fermerait les activités ouvertes
                 par-dessus l'application (sélecteur d'images, connexion
                 Google) à chaque partage reçu. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>

        <!-- Depuis Android 7, un `file://` passé à une autre application lève
             FileUriExposedException : l'installateur du système reçoit donc un
             `content://` servi par ce provider.

             L'autorité porte le suffixe `.updateprovider` et non `.fileprovider` :
             image_picker, file_picker et image_cropper déclarent chacun le leur,
             et deux providers de même autorité font échouer l'installation de
             l'APK avec un conflit au moment de la fusion des manifestes. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updateprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher : supportsLaunchMode(LaunchMode.inAppBrowserView)
             cherche un navigateur qui offre les Custom Tabs. Sans cette
             déclaration, Android 11+ le lui cache, et les pages de
             l'Explorer s'ouvriraient hors de l'application. -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
</manifest>
