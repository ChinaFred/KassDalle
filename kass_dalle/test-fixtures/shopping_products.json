        { "name": "sauce soja claire", "qty": "6", "unit": "c. à soupe" }
      ],
      "expected": [
        { "name": "sauce soja claire", "qty": "8", "unit": "c. à soupe" },
        { "name": "porc haché", "qty": "250", "unit": "g" }
      ]
    },
    {
      "why": "kilo et grammes s'additionnent, le total repasse en kilo",
      "inputs": [
        { "name": "farine", "qty": "1", "unit": "kg" },
        { "name": "farine", "qty": "500", "unit": "g" }
      ],
      "expected": [{ "name": "farine", "qty": "1,5", "unit": "kg" }]
    },
    {
      "why": "deux centilitres s'additionnent en millilitres",
      "inputs": [
        { "name": "crème liquide", "qty": "20", "unit": "cl" },
        { "name": "crème liquide", "qty": "20", "unit": "cl" }
      ],
      "expected": [{ "name": "crème liquide", "qty": "400", "unit": "ml" }]
    },
    {
      "why": "une ligne seule garde sa quantité et son unité telles qu'écrites",
      "inputs": [{ "name": "sucre", "qty": "0,5", "unit": "kg" }],
      "expected": [{ "name": "sucre", "qty": "0,5", "unit": "kg" }]
    },
    {
      "why": "une fraction écrite garde sa forme tant qu'elle est seule",
      "inputs": [{ "name": "citron", "qty": "1/2", "unit": "" }],
      "expected": [{ "name": "citron", "qty": "1/2", "unit": "" }]
    },
    {
      "why": "deux fractions s'additionnent",
      "inputs": [
        { "name": "citron", "qty": "1/2", "unit": "" },
        { "name": "citrons", "qty": "½", "unit": "pièce" }
      ],
      "expected": [{ "name": "citron", "qty": "1", "unit": "" }]
    },
    {
      "why": "casse et accents ne font pas deux produits ; le premier nom lu nomme la ligne",
      "inputs": [
        { "name": "Lait de coco", "qty": "250", "unit": "g" },
        { "name": "lait de coco", "qty": "400", "unit": "ml" }
      ],
      "expected": [
        { "name": "Lait de coco", "qty": "250", "unit": "g" },
        { "name": "Lait de coco", "qty": "400", "unit": "ml" }
      ]
    },
    {
      "why": "une quantité non chiffrable est conservée, pas jetée",
      "inputs": [{ "name": "huile", "qty": "à volonté", "unit": "" }],
      "expected": [{ "name": "huile", "qty": "à volonté", "unit": "" }]
    },
    {
      "why": "le chiffrable et le non-chiffrable se lisent ensemble",
      "inputs": [
        { "name": "huile", "qty": "2", "unit": "c. à soupe" },
        { "name": "huile", "qty": "pour la friture", "unit": "c. à soupe" }
      ],
      "expected": [{ "name": "huile", "qty": "2 + pour la friture", "unit": "c. à soupe" }]
    },
    {
      "why": "le pluriel d'une unité ne crée pas un second produit",
      "inputs": [
        { "name": "oeuf", "qty": "2", "unit": "pièce" },
        { "name": "oeuf", "qty": "1", "unit": "pièces" }
      ],
      "expected": [{ "name": "oeuf", "qty": "3", "unit": "pièce" }]
    },
    {
      "why": "deux unités sans conversion exacte restent deux lignes",
      "inputs": [
        { "name": "ail", "qty": "2", "unit": "gousse" },
        { "name": "ail", "qty": "1", "unit": "c. à café" }
      ],
      "expected": [
        { "name": "ail", "qty": "2", "unit": "gousse" },
        { "name": "ail", "qty": "1", "unit": "c. à café" }
      ]
    },
    {
      "why": "un mot de préparation ne fait pas un second produit ; le premier nom lu reste",
      "inputs": [
        { "name": "oignon haché", "qty": "1", "unit": "" },
        { "name": "oignon", "qty": "2", "unit": "" }
      ],
      "expected": [{ "name": "oignon haché", "qty": "3", "unit": "" }]
    },
    {
      "why": "un ingrédient sans nom ne devient pas une ligne",
      "inputs": [
        { "name": "  ", "qty": "2", "unit": "g" },
        { "name": "sel", "qty": "1", "unit": "pincée" }
      ],
      "expected": [{ "name": "sel", "qty": "1", "unit": "pincée" }]
    },
    {
      "why": "un produit acheté vide vaut le nom",
      "inputs": [
        { "name": "riz", "qty": "200", "unit": "g", "shopping_product": "" },
        { "name": "riz", "qty": "100", "unit": "g" }
      ],
      "expected": [{ "name": "riz", "qty": "300", "unit": "g" }]
    }
  ]
}
