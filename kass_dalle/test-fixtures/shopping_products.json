        { "name": "jaune d'œuf", "qty": "2", "unit": "", "shopping_product": "œuf" },
        { "name": "œufs", "qty": "3", "unit": "" }
      ],
      "expected": [{ "name": "œuf", "qty": "5", "unit": "" }]
    },
    {
      "why": "la section est ignorée : deux cuillères pour la farce et six pour la sauce font une bouteille",
      "inputs": [
        { "name": "sauce soja claire", "qty": "2", "unit": "c. à soupe" },
