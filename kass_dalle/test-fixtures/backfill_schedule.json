{
  "_doc": "Backfills ponctuels et récurrents : ce que le client et le serveur doivent lire à l'identique. Rejouée par functions/src/tests/backfillSchedule.test.ts (backfills/registry.ts, backfills/schedule.ts parseSchedule) et test/backfill_status_test.dart (backfill_registry.dart, BackfillSchedule.fromMap). Le défaut de programmation et la durée du verrou ne sont plus en double : le serveur écrit le défaut dans app_config/backfill_schedules et l'échéance du verrou dans en_cours_expire_le.",
  "registry": [
    { "key": "nutrition", "kind": "recurrent", "uses_ai": true },
    { "key": "enrich_referentials", "kind": "recurrent", "uses_ai": true },
    { "key": "allergens", "kind": "recurrent", "uses_ai": true },
    { "key": "recipe_roles", "kind": "recurrent", "uses_ai": true },
    { "key": "shopping_products", "kind": "recurrent", "uses_ai": false },
    { "key": "recipe_protein", "kind": "ponctuel", "uses_ai": true },
    { "key": "estimated_times", "kind": "ponctuel", "uses_ai": true },
    { "key": "refresh_sodium", "kind": "ponctuel", "uses_ai": true },
    { "key": "planning_defaults", "kind": "ponctuel", "uses_ai": false }
  ],
  "parse_schedule": [
    {
      "name": "valide : jours triés et dédoublonnés, auteur nettoyé",
      "input": { "enabled": true, "days": [7, 3, 3], "hour": 3, "programme_par_uid": " a1 " },
      "expected": { "enabled": true, "days": [3, 7], "hour": 3, "programme_par_uid": "a1" }
    },
    {
      "name": "tous les jours à 5 h, sans auteur (défaut semé par le serveur)",
      "input": { "enabled": true, "days": [1, 2, 3, 4, 5, 6, 7], "hour": 5, "programme_par_uid": null },
      "expected": { "enabled": true, "days": [1, 2, 3, 4, 5, 6, 7], "hour": 5, "programme_par_uid": null }
    },
    {
      "name": "enabled absent : désactivé",
      "input": { "days": [1], "hour": 0 },
      "expected": { "enabled": false, "days": [1], "hour": 0, "programme_par_uid": null }
    },
    {
      "name": "enabled en chaîne : désactivé",
      "input": { "enabled": "true", "days": [1], "hour": 23 },
      "expected": { "enabled": false, "days": [1], "hour": 23, "programme_par_uid": null }
    },
    {
      "name": "aucun jour : désactivé, mais lisible",
      "input": { "enabled": true, "days": [], "hour": 3, "programme_par_uid": "" },
      "expected": { "enabled": false, "days": [], "hour": 3, "programme_par_uid": null }
    },
    { "name": "heure en chaîne", "input": { "enabled": true, "days": [1], "hour": "5" }, "expected": null },
    { "name": "heure non entière", "input": { "enabled": true, "days": [1], "hour": 5.5 }, "expected": null },
    { "name": "heure nulle", "input": { "enabled": true, "days": [1], "hour": null }, "expected": null },
    { "name": "heure booléenne", "input": { "enabled": true, "days": [1], "hour": true }, "expected": null },
    { "name": "heure hors plage", "input": { "enabled": true, "days": [1], "hour": 24 }, "expected": null },
    { "name": "heure négative", "input": { "enabled": true, "days": [1], "hour": -1 }, "expected": null },
    { "name": "heure absente", "input": { "enabled": true, "days": [1] }, "expected": null },
    { "name": "jour en chaîne", "input": { "enabled": true, "days": ["1"], "hour": 3 }, "expected": null },
    { "name": "jour non entier", "input": { "enabled": true, "days": [1.5], "hour": 3 }, "expected": null },
    { "name": "jour nul", "input": { "enabled": true, "days": [1, null], "hour": 3 }, "expected": null },
    { "name": "jour booléen", "input": { "enabled": true, "days": [true], "hour": 3 }, "expected": null },
    { "name": "jour hors plage", "input": { "enabled": true, "days": [8], "hour": 3 }, "expected": null },
    { "name": "jour zéro", "input": { "enabled": true, "days": [0], "hour": 3 }, "expected": null },
    { "name": "jours qui ne sont pas une liste", "input": { "enabled": true, "days": "1", "hour": 3 }, "expected": null },
    { "name": "jours absents", "input": { "enabled": true, "hour": 3 }, "expected": null },
    { "name": "entrée qui n'est pas un objet", "input": "x", "expected": null },
    { "name": "entrée nulle", "input": null, "expected": null }
  ]
}
