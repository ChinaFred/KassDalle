      "candidate": "riz",
      "neighbours": ["riz"],
      "expected": true,
      "why": "même féculent que la veille"
    },
    {
      "candidate": "pates",
      "neighbours": ["riz", "semoule"],
      "expected": false,
      "why": "féculent différent des deux voisins"
    },
    {
      "candidate": "aucun",
      "neighbours": ["aucun"],
      "expected": false,
      "why": "« aucun » ne se répète pas"
    },
    {
