        { "recipe_id": "b", "date": "2026-09-03" }
      ],
      "slots_to_fill": 3,
      "expected_candidates": ["c", "d", "e"],
      "expected_excluded": ["b", "a"],
      "expected_kept": [],
      "why": "cinq recettes, deux servies, trois créneaux : les deux servies partent, le plus récent d'abord"
    },
    {
      "corpus": ["a", "b", "c", "d"],
      "served": [
        { "recipe_id": "a", "date": "2026-09-01" },
        { "recipe_id": "b", "date": "2026-09-03" }
      ],
      "slots_to_fill": 3,
      "expected_candidates": ["a", "c", "d"],
      "expected_excluded": ["b"],
      "expected_kept": ["a"],
