    { "main_starch": "riz", "expected": "riz", "why": "valeur admise" },
    { "main_starch": "pommes_de_terre", "expected": "pommes_de_terre", "why": "clé à tiret bas" },
    { "main_starch": "quinoa", "expected": null, "why": "hors liste : absent" },
    { "main_starch": null, "expected": null, "why": "absent" },
    { "main_starch": "aucun", "expected": "aucun", "why": "pas de féculent : une valeur" }
  ],
  "_starch_repeat_comment": "Alternance des féculents. Un plat dont le féculent (hors « aucun ») est celui d'un créneau voisin (veille ou lendemain : recette déjà assignée, ou premier plat classé du créneau précédent) pèse x0,5. Jamais une exclusion.",
