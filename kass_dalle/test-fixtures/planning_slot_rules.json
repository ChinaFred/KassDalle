    {
      "key": null,
      "expected": { "wantsStarter": false, "wantsDessert": false, "light": false },
      "why": "pas réglé : plat seul"
    },
    {
      "key": "",
      "expected": { "wantsStarter": false, "wantsDessert": false, "light": false },
      "why": "vide : plat seul"
    },
    {
      "key": "plat",
      "expected": { "wantsStarter": false, "wantsDessert": false, "light": false },
      "why": "le défaut, écrit en clair"
    },
    {
      "key": "plat_dessert",
      "expected": { "wantsStarter": false, "wantsDessert": true, "light": false },
      "why": "un dessert, pas d'entrée"
    },
    {
      "key": "entree_plat",
      "expected": { "wantsStarter": true, "wantsDessert": false, "light": false },
      "why": "une entrée, pas de dessert"
    },
    {
      "key": "entree_plat_dessert",
