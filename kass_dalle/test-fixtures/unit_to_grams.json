    { "ingredient": "sucre",   "qty": "250", "unit": "gr",  "grams": 250,   "why": "alias gr" },

    { "ingredient": "eau",     "qty": "1",   "unit": "l",   "grams": 1000,  "why": "volume, densité 1" },
