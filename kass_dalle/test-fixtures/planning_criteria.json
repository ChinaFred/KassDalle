        "excluded_allergens": [],
        "excluded_proteins": [],
        "excluded_starches": [],
        "wanted_proteins": [],
        "wanted_starches": [],
        "max_duration": null,
        "light": false,
        "wanted_styles": []
      }
    },
    {
      "name": "durée décimale : absente",
      "raw": { "max_duration": 30.5 },
      "expected": {
        "excluded_allergens": [],
        "excluded_proteins": [],
        "excluded_starches": [],
        "wanted_proteins": [],
        "wanted_starches": [],
        "max_duration": null,
        "light": false,
        "wanted_styles": []
      }
    },
    {
      "name": "durée au plafond : gardée",
      "raw": { "max_duration": 600 },
      "expected": {
        "excluded_allergens": [],
        "excluded_proteins": [],
        "excluded_starches": [],
        "wanted_proteins": [],
        "wanted_starches": [],
        "max_duration": 600,
        "light": false,
        "wanted_styles": []
      }
    },
    {
      "name": "light en texte : faux",
      "raw": { "light": "true" },
      "expected": {
        "excluded_allergens": [],
        "excluded_proteins": [],
        "excluded_starches": [],
        "wanted_proteins": [],
