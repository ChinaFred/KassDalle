  "_merge_comment": "Critères d'un créneau : ceux des préférences générales et ceux de la note du jour, réunis. Listes (styles compris) : union, dans l'ordre du vocabulaire. max_duration : la plus petite. light : l'un ou l'autre. L'exclusion l'emporte encore sur le voulu.",
  "merge_cases": [
    {
      "name": "union et durée la plus courte",
      "parts": [
        { "excluded_allergens": ["lait"], "max_duration": 45, "wanted_proteins": ["porc"] },
        { "excluded_allergens": ["gluten"], "max_duration": 30, "excluded_proteins": ["porc"] }
      ],
      "expected": {
        "excluded_allergens": ["gluten", "lait"],
        "excluded_proteins": ["porc"],
        "excluded_starches": [],
        "wanted_proteins": [],
        "wanted_starches": [],
        "max_duration": 30,
        "light": false,
        "wanted_styles": []
      }
    },
    {
      "name": "une seule durée, léger d'un côté",
      "parts": [{ "light": true }, { "max_duration": 20 }],
      "expected": {
        "excluded_allergens": [],
        "excluded_proteins": [],
        "excluded_starches": [],
        "wanted_proteins": [],
        "wanted_starches": [],
        "max_duration": 20,
        "light": true,
        "wanted_styles": []
      }
    },
    {
      "name": "styles : union, dans l'ordre du vocabulaire",
      "parts": [{ "wanted_styles": ["barbecue"] }, { "wanted_styles": ["street_food", "barbecue"] }],
      "expected": {
        "excluded_allergens": [],
        "excluded_proteins": [],
        "excluded_starches": [],
        "wanted_proteins": [],
        "wanted_starches": [],
        "max_duration": null,
        "light": false,
        "wanted_styles": ["street_food", "barbecue"]
      }
    },
    {
      "name": "aucune partie",
      "parts": [],
      "expected": {
        "excluded_allergens": [],
        "excluded_proteins": [],
        "excluded_starches": [],
        "wanted_proteins": [],
        "wanted_starches": [],
        "max_duration": null,
        "light": false,
        "wanted_styles": []
      }
    }
  ],
  "_exclusion_comment": "Prédicat d'exclusion, rejoué par les deux côtés. Un résultat par critère d'exclusion actif, dans l'ordre du vocabulaire. verdict : violates (l'élément contient ce qui est exclu, values = ce qui est en cause), ok (vérifié), unknown (donnée absente ou incomplète : values = ce qui n'a pas pu être vérifié). Allergènes : une clé exclue présente dans allergens.present viole, même si complete est faux ; sinon, sans champ allergens ou avec complete faux, le verdict est unknown — une donnée absente ne prouve rien. Protéine et féculent : la valeur principale de l'élément (main_protein, main_starch) ; absente ou hors vocabulaire : unknown. La protéine exclue ne vérifie que la protéine principale.",
  "exclusion_cases": [
    {
      "name": "allergène exclu présent : viole",
      "criteria": { "excluded_allergens": ["fruits_a_coque", "gluten"] },
      "item": { "allergens": { "present": ["fruits_a_coque", "lait"], "complete": true } },
      "expected": [{ "key": "excluded_allergens", "verdict": "violates", "values": ["fruits_a_coque"] }]
    },
    {
      "name": "allergène exclu présent, liste incomplète : viole quand même",
      "criteria": { "excluded_allergens": ["gluten"] },
      "item": { "allergens": { "present": ["gluten"], "complete": false } },
      "expected": [{ "key": "excluded_allergens", "verdict": "violates", "values": ["gluten"] }]
    },
    {
      "name": "allergène absent d'une liste complète : vérifié",
      "criteria": { "excluded_allergens": ["gluten"] },
      "item": { "allergens": { "present": ["lait"], "complete": true } },
      "expected": [{ "key": "excluded_allergens", "verdict": "ok", "values": [] }]
    },
    {
      "name": "allergène absent d'une liste incomplète : non vérifié",
      "criteria": { "excluded_allergens": ["gluten", "lait"] },
      "item": { "allergens": { "present": [], "complete": false } },
      "expected": [
        { "key": "excluded_allergens", "verdict": "unknown", "values": ["gluten", "lait"] }
      ]
    },
    {
      "name": "allergènes non renseignés : non vérifié",
      "criteria": { "excluded_allergens": ["sesame"] },
      "item": { "allergens": null },
      "expected": [{ "key": "excluded_allergens", "verdict": "unknown", "values": ["sesame"] }]
    },
    {
      "name": "protéine principale exclue : viole",
      "criteria": { "excluded_proteins": ["porc", "boeuf"] },
      "item": { "main_protein": "porc" },
      "expected": [{ "key": "excluded_proteins", "verdict": "violates", "values": ["porc"] }]
    },
    {
      "name": "autre protéine principale : vérifié",
      "criteria": { "excluded_proteins": ["porc"] },
      "item": { "main_protein": "volaille" },
      "expected": [{ "key": "excluded_proteins", "verdict": "ok", "values": [] }]
    },
    {
      "name": "protéine inconnue ou hors liste : non vérifié",
      "criteria": { "excluded_proteins": ["porc"] },
      "item": { "main_protein": "viande" },
      "expected": [{ "key": "excluded_proteins", "verdict": "unknown", "values": ["porc"] }]
    },
    {
      "name": "plat sans féculent, pâtes exclues : vérifié",
      "criteria": { "excluded_starches": ["pates"] },
      "item": { "main_starch": "aucun" },
      "expected": [{ "key": "excluded_starches", "verdict": "ok", "values": [] }]
    },
    {
      "name": "féculent principal exclu : viole",
      "criteria": { "excluded_starches": ["pates", "riz"] },
      "item": { "main_starch": "pates" },
      "expected": [{ "key": "excluded_starches", "verdict": "violates", "values": ["pates"] }]
    },
    {
      "name": "trois exclusions, dans l'ordre du vocabulaire",
      "criteria": {
        "excluded_starches": ["riz"],
        "excluded_proteins": ["porc"],
        "excluded_allergens": ["lait"]
      },
      "item": {
        "allergens": { "present": [], "complete": true },
        "main_protein": "porc"
      },
      "expected": [
        { "key": "excluded_allergens", "verdict": "ok", "values": [] },
        { "key": "excluded_proteins", "verdict": "violates", "values": ["porc"] },
        { "key": "excluded_starches", "verdict": "unknown", "values": ["riz"] }
      ]
    },
    {
      "name": "aucune exclusion : aucun résultat",
      "criteria": { "wanted_proteins": ["poisson"], "max_duration": 30 },
      "item": { "main_protein": "porc", "prep_minutes": 60 },
      "expected": []
    }
  ],
  "_preference_comment": "Prédicat des préférences — serveur seul : le client n'applique que les exclusions. verdict : violates (préférence non tenue, values = ce que l'élément porte), ok, unknown (donnée absente : l'élément passe, faute de preuve contraire). max_duration compare prep_minutes, la préparation, comme la contrainte « Prépa max ». light : l'élément dit s'il est léger (true, false ou absent). wanted_styles : l'un des styles voulus suffit (union) ; styles absent = recette jamais examinée (pas de tags.styles_checked_at), le verdict est unknown ; values = les styles de l'élément, dans l'ordre du vocabulaire.",
  "preference_cases": [
    {
      "name": "style voulu : tenu",
      "criteria": { "wanted_styles": ["street_food", "barbecue"] },
      "item": { "styles": ["barbecue", "festif"] },
      "expected": [{ "key": "wanted_styles", "verdict": "ok", "values": [] }]
    },
    {
      "name": "style voulu : non tenu, la recette n'en porte aucun",
      "criteria": { "wanted_styles": ["street_food"] },
      "item": { "styles": [] },
      "expected": [{ "key": "wanted_styles", "verdict": "violates", "values": [] }]
    },
    {
      "name": "style voulu : non tenu, la recette en porte un autre",
      "criteria": { "wanted_styles": ["street_food"] },
      "item": { "styles": ["frais_estival", "healthy"] },
      "expected": [{ "key": "wanted_styles", "verdict": "violates", "values": ["healthy", "frais_estival"] }]
    },
    {
      "name": "style voulu, recette jamais examinée : passe",
      "criteria": { "wanted_styles": ["street_food"] },
      "item": {},
      "expected": [{ "key": "wanted_styles", "verdict": "unknown", "values": [] }]
    },
    {
      "name": "protéine voulue : tenue",
      "criteria": { "wanted_proteins": ["poisson", "fruits_de_mer"] },
      "item": { "main_protein": "poisson" },
      "expected": [{ "key": "wanted_proteins", "verdict": "ok", "values": [] }]
    },
    {
      "name": "protéine voulue : non tenue",
      "criteria": { "wanted_proteins": ["poisson"] },
      "item": { "main_protein": "boeuf" },
      "expected": [{ "key": "wanted_proteins", "verdict": "violates", "values": ["boeuf"] }]
    },
    {
      "name": "féculent voulu, féculent inconnu : passe",
      "criteria": { "wanted_starches": ["riz"] },
      "item": {},
      "expected": [{ "key": "wanted_starches", "verdict": "unknown", "values": [] }]
    },
    {
      "name": "durée au-delà : non tenue",
      "criteria": { "max_duration": 45 },
      "item": { "prep_minutes": 70 },
      "expected": [{ "key": "max_duration", "verdict": "violates", "values": ["70"] }]
    },
    {
      "name": "durée à la borne : tenue",
      "criteria": { "max_duration": 45 },
      "item": { "prep_minutes": 45 },
      "expected": [{ "key": "max_duration", "verdict": "ok", "values": [] }]
    },
    {
      "name": "durée absente : passe",
      "criteria": { "max_duration": 45 },
      "item": {},
      "expected": [{ "key": "max_duration", "verdict": "unknown", "values": [] }]
    },
    {
      "name": "léger demandé, plat copieux : non tenu",
      "criteria": { "light": true },
      "item": { "light": false },
      "expected": [{ "key": "light", "verdict": "violates", "values": [] }]
    },
    {
      "name": "quatre préférences, dans l'ordre du vocabulaire",
      "criteria": {
        "light": true,
        "max_duration": 30,
        "wanted_starches": ["riz"],
        "wanted_proteins": ["volaille"]
      },
      "item": { "main_protein": "volaille", "main_starch": "pates", "prep_minutes": 20, "light": true },
      "expected": [
        { "key": "wanted_proteins", "verdict": "ok", "values": [] },
        { "key": "wanted_starches", "verdict": "violates", "values": ["pates"] },
        { "key": "max_duration", "verdict": "ok", "values": [] },
        { "key": "light", "verdict": "ok", "values": [] }
      ]
    }
  ],
  "_weekday_comment": "Portée par jour de semaine. Un texte compris porte les critères valables tous les jours (criteria) et, à part, ceux qu'il réserve à un jour nommé (« le vendredi ») : criteria_by_weekday, clés \"1\" (lundi) à \"7\" (dimanche), chaque valeur un objet de critères lu comme read_cases. Lecture (weekday_read_cases) : une clé hors 1 à 7, une valeur qui n'est pas un objet ou un objet sans critère est écartée ; expected : les jours gardés, forme canonique. Critères d'un texte pour un jour (weekday_cases) : criteria réunis à ceux de ce jour, même réunion que merge_cases. Le serveur l'applique à chaque créneau selon son jour de semaine (slotCriteriaOf), le client au jour affiché (criteriaForDay).",
  "weekday_read_cases": [
    {"name": "vendredi seul", "raw": {"5": {"wanted_styles": ["street_food"]}}, "expected": {"5": {"excluded_allergens": [], "excluded_proteins": [], "excluded_starches": [], "wanted_proteins": [], "wanted_starches": [], "max_duration": null, "light": false, "wanted_styles": ["street_food"]}}},
    {"name": "clés hors 1 à 7, valeurs vides ou illisibles écartées", "raw": {"0": {"light": true}, "8": {"light": true}, "vendredi": {"light": true}, "5.0": {"light": true}, "1": {}, "2": {"wanted_styles": ["junk_food"]}, "3": "porc", "7": {"excluded_proteins": ["porc"]}}, "expected": {"7": {"excluded_allergens": [], "excluded_proteins": ["porc"], "excluded_starches": [], "wanted_proteins": [], "wanted_starches": [], "max_duration": null, "light": false, "wanted_styles": []}}},
    {"name": "pas un objet : aucun jour", "raw": [{"wanted_styles": ["street_food"]}], "expected": {}},
    {"name": "absent : aucun jour", "raw": null, "expected": {}}
  ],
  "weekday_cases": [
    {"name": "le vendredi : le style s'ajoute au vendredi", "criteria": {"excluded_proteins": ["porc"]}, "criteria_by_weekday": {"5": {"wanted_styles": ["street_food"]}}, "weekday": 5, "expected": {"excluded_allergens": [], "excluded_proteins": ["porc"], "excluded_starches": [], "wanted_proteins": [], "wanted_starches": [], "max_duration": null, "light": false, "wanted_styles": ["street_food"]}},
    {"name": "un autre jour : le style du vendredi ne s'applique pas", "criteria": {"excluded_proteins": ["porc"]}, "criteria_by_weekday": {"5": {"wanted_styles": ["street_food"]}}, "weekday": 2, "expected": {"excluded_allergens": [], "excluded_proteins": ["porc"], "excluded_starches": [], "wanted_proteins": [], "wanted_starches": [], "max_duration": null, "light": false, "wanted_styles": []}},
    {"name": "réunion : durée la plus courte, exclusion qui l'emporte", "criteria": {"max_duration": 45, "wanted_proteins": ["porc"]}, "criteria_by_weekday": {"3": {"max_duration": 20, "excluded_proteins": ["porc"]}}, "weekday": 3, "expected": {"excluded_allergens": [], "excluded_proteins": ["porc"], "excluded_starches": [], "wanted_proteins": [], "wanted_starches": [], "max_duration": 20, "light": false, "wanted_styles": []}},
    {"name": "sans portée par jour", "criteria": {"light": true}, "criteria_by_weekday": null, "weekday": 1, "expected": {"excluded_allergens": [], "excluded_proteins": [], "excluded_starches": [], "wanted_proteins": [], "wanted_starches": [], "max_duration": null, "light": true, "wanted_styles": []}}
  ]
}
