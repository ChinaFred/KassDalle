{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "kassdale-6d948",
          "appId": "1:867114764221:android:779af4be1b5d10372e34d4",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "kassdale-6d948",
          "configurations": {
            "android": "1:867114764221:android:779af4be1b5d10372e34d4",
            "ios": "1:867114764221:ios:5267fb7e188e65bf2e34d4",
            "macos": "1:867114764221:ios:5267fb7e188e65bf2e34d4",
            "web": "1:867114764221:web:a2405bb67d0236172e34d4",
            "windows": "1:867114764221:web:59f031846c7f4e442e34d4"
          }
        }
      }
    }
  },
  "firestore": {
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|wasm)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "flutter_service_worker.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "version.json",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}