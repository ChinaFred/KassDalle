{
  "name": "kass-dalle-functions",
  "version": "1.0.0",
  "description": "Cloud Functions backend for Kass'Dalle (Gemini orchestration + Cloud Tasks queue).",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint src",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,storage,auth",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^7.9.4",
    "@google-cloud/logging": "^11.2.0",
    "@google-cloud/tasks": "^5.5.2",
    "@google/generative-ai": "^0.21.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^7.2.5",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.66.0"
  },
  "private": true
}
