rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Autorisation : le jeton d'abord, le document `users/{uid}` ensuite ──
    //
    // Le rôle et la révocation voyagent dans le jeton, entretenus par le
    // déclencheur `syncUserClaims`. Un jeton vit une heure : jusqu'à la
    // v0.24.46, un administrateur rétrogradé ou un compte révoqué gardait ici
    // les droits de son ancien jeton pendant ce temps, alors que Firestore les
    // lui retirait tout de suite (`roleOf()`, `isRevoked()`, v0.24.30).
    //
    // Depuis la v0.24.47, chaque décision qui demande un rôle — écrire, lire en
    // administrateur — relit aussi `users/{uid}` par une règle inter-services
    // (`firestore.get`), avec la même logique que `firestore.rules` : rôle du
    // document, claim seulement si le document n'en porte pas ; révocation du
    // document, que le jeton peut confirmer mais pas infirmer. Le jeton reste
    // la première porte : sans claim de rôle approuvé, la règle refuse sans
    // lire Firestore. Un compte en attente ou un inconnu ne déclenche donc
    // aucune lecture facturée, et un rôle n'est accordé que si le jeton ET le
    // document l'accordent. Un compte nommé à l'instant attend son jeton (une
    // heure au plus), comme avant ; un rôle retiré prend effet tout de suite.
    //
    // Coût : une lecture Firestore par requête qui atteint le contrôle de
    // rôle — dépôts dans `quarantine/` et `tickets/`, listages et lectures
    // d'administrateur. Les images affichées passent par une URL de
    // téléchargement, que les règles n'évaluent pas, et les `get` des
    // dossiers publiés restent sur le jeton seul (`isActive()`).
    //
    // Prérequis hors dépôt : le compte de service Storage
    // (`service-<numéro>@gcp-sa-firebasestorage.iam.gserviceaccount.com`)
    // doit porter le rôle IAM `roles/firebaserules.firestoreServiceAgent`.
    // Sans lui, `firestore.get` échoue, une erreur vaut refus, et tous les
    // dépôts sont refusés. La CLI ne l'accorde pas en `--non-interactive`
    // (workflow « Déploiement ») : voir `handbook-reseau-agents.md`.
    //
    // Un claim facultatif se teste d'abord par sa présence
    // (`'revoked' in request.auth.token`) : comparer une clé absente lève une
    // erreur, et une erreur vaut refus.

    function isAuthenticated() {
      return request.auth != null;
    }

    /// Révoqué, selon le jeton : UNIQUEMENT si le claim le dit explicitement.
    /// Un jeton sans claim `revoked` — compte ancien, claim pas encore
    /// propagé — est traité comme actif : la migration ne doit verrouiller
    /// personne dehors. La présence se teste avant la valeur : comparer une
    /// clé absente lève une erreur, et l'erreur refusait l'accès.
    ///
    /// Ne lit que le jeton : garde les `get` des dossiers publiés, dont les
    /// fichiers restent de toute façon joignables par leur URL de
    /// téléchargement. Le document n'y ajouterait qu'une lecture facturée.
    function isActive() {
      return isAuthenticated()
        && (!('revoked' in request.auth.token) || request.auth.token.revoked != true);
    }

    /// Le document `users/{uid}` de l'appelant, lu dans Firestore.
    /// Sans document, l'accès à `.data` échoue et la règle refuse, comme
    /// `getUserData()` dans `firestore.rules`.
    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    /// Le rôle en vigueur, à l'identique de `roleOf()` (`firestore.rules`) :
    /// celui du document, ou le claim quand le document ne porte pas de rôle.
    function roleOf(d) {
      return d.get('role', null) != null ? d.role : request.auth.token.get('role', null);
    }

    /// Révoqué, à l'identique de `isRevoked()` (`firestore.rules`) : le jeton
    /// peut confirmer une révocation, le document la décide.
    function isRevoked(d) {
      return ('revoked' in request.auth.token && request.auth.token.revoked == true)
        || d.is_revoked == true;
    }

    /// Un rôle parmi `roles`, accordé par le jeton puis par le document.
    ///
    /// Le jeton se teste d'abord : s'il n'annonce pas un de ces rôles, la règle
    /// refuse sans lire Firestore. Le document se lit une fois, puis passe
    /// en paramètre à `roleOf` et `isRevoked`.
    function hasRoleIn(roles) {
      return isActive()
        && request.auth.token.get('role', null) in roles
        && hasDocRoleIn(userDoc(), roles);
    }

    function hasDocRoleIn(d, roles) {
      return !isRevoked(d) && roleOf(d) in roles;
    }

    /// Administrateur, selon le jeton et selon le document.
    ///
    /// Sert les lectures qui ne sont pas ouvertes à la famille : les images
    /// refusées par la modération, la quarantaine des autres, les listages.
    /// Ici l'absence de preuve vaut refus, parce que `rejected/` contient
    /// ce qu'on a jugé impubliable. Un administrateur rétrogradé perd l'accès
    /// tout de suite, sans attendre son jeton.
    function isAdmin() {
      return hasRoleIn(['admin']);
    }

    /// Un compte nommé : le sas d'entrée vaut aussi pour les dépôts de fichiers.
    ///
    /// Ne concerne que l'ÉCRITURE. Les lectures restent sur `isActive()` : un
    /// essai d'aligner la lecture sur le rôle (2026-10-05) a coupé l'accès au
    /// fondateur lui-même, le temps que son jeton porte le claim. Revenu en
    /// arrière : un gain de confidentialité faible contre un compte en attente
    /// ne vaut pas le risque de couper l'accès à un compte déjà approuvé.
    function isApproved() {
      return hasRoleIn(['reader', 'editor', 'admin']);
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    /// Un éditeur ou un administrateur nommé, selon le jeton et le document.
    ///
    /// Seuls ces deux rôles importent : `analyzeBookImport`, l'extraction de
    /// texte et la création d'un job de traitement exigent `requireEditor`
    /// (ou `isEditor()` côté Firestore). Un lecteur qui déposait un PDF ou un
    /// livre de 300 Mo occupait le bucket sans qu'aucun traitement ne puisse
    /// ensuite s'en servir (audit #151, ticket #162).
    function isEditor() {
      return hasRoleIn(['editor', 'admin']);
    }

    /// Le type MIME sans ses paramètres : le texte collé s'envoie en
    /// `text/plain; charset=utf-8`, et une comparaison exacte le refuserait.
    function baseContentType() {
      return request.resource.contentType.split(';')[0].trim();
    }

    /// Les seuls types qu'un import de recette produit : photo, scan PDF,
    /// document Word, texte collé. Même liste que `ALLOWED_MIME_TYPES` dans
    /// `functions/src/utils/uploadSecurity.ts`, qui décide côté serveur — le
    /// fichier y est de toute façon inspecté avant d'être promu hors de la
    /// quarantaine. Ce contrôle-ci ne remplace pas cette inspection : il évite
    /// que le dépôt lui-même serve à autre chose.
    ///
    /// Sans lui, la quarantaine acceptait **n'importe quel** fichier jusqu'à
    /// cinquante mégaoctets : le bucket servait d'hébergement gratuit à qui
    /// possédait un compte, et rien dans le suivi de stockage n'aurait
    /// distingué ces octets-là des recettes de la famille.
    ///
    /// Réservé aux éditeurs et aux administrateurs : voir [isReaderImageUnder]
    /// pour le lecteur.
    function isImportableUnder(maxBytes) {
      return request.resource.size < maxBytes
        && baseContentType() in [
             'image/jpeg',
             'image/png',
             'application/pdf',
             'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
             'text/plain'
           ];
    }

    /// Ce qu'un lecteur dépose : une photo, JPEG ou PNG, hors de `livres/`.
    ///
    /// Il ne dépose que des images à modérer — couverture « Recette libre »,
    /// illustration d'une de ses recettes — et `ImageModerationService`
    /// n'envoie que ces deux types canoniques. Le reste de la liste
    /// d'[isImportableUnder] sert l'import, qui lui est refusé.
    ///
    /// `livres/` est exclu par le nom complet de l'objet : les deux blocs
    /// `match` de la quarantaine se recouvrent, et sans ce test une photo d'un
    /// lecteur passerait sous `livres/` par le bloc général.
    function isReaderImageUnder(maxBytes) {
      return request.resource.size < maxBytes
        && baseContentType() in ['image/jpeg', 'image/png']
        && !request.resource.name.matches('quarantine/[^/]+/livres/.*');
    }

    // Couvertures de livres — écrites par le serveur pour le créateur du livre
    // ou un administrateur, comme le livre lui-même côté Firestore.
    // Dossiers PUBLIÉS : écriture serveur uniquement, comme `scans/`.
    //
    // Une image vue par toute la famille passe par la quarantaine et par la
    // modération avant d'atterrir ici. Laisser le client y écrire en direct
    // rendrait la modération contournable en une ligne de code.
    match /covers/{allPaths=**} {
      // Lire un fichier par son adresse : tout compte actif. Lister : admin.
      allow get: if isActive();
      allow list: if isAdmin();
      allow write: if false;
    }

    // Quarantaine : zone d'atterrissage avant le scan serveur ET la modération.
    // C'est désormais la SEULE porte d'entrée d'une image : les quatre dossiers
    // publiés sont fermés en écriture, et seul le serveur y dépose.
    // Chemin critique de l'import, et début d'une chaîne d'appels d'IA
    // facturés : la propriété du dossier ne suffit donc pas, le compte doit
    // avoir été nommé.
    // La lecture est ouverte à l'ADMINISTRATEUR en plus du propriétaire.
    //
    // Une image « à revoir » attend ici. Sans cette ligne, l'administrateur
    // chargé de trancher ne pouvait pas la voir — sauf s'il l'avait envoyée
    // lui-même — et devait donc décider à l'aveugle, sur des scores. Le seul
    // écran qui compte devenait inutilisable.
    //
    // Un lecteur n'y dépose que des photos (JPEG, PNG) ; un éditeur ou un
    // administrateur, tous les types d'un import.
    //
    // Le type et la taille se testent avant le rôle : un dépôt refusé pour
    // son contenu ne lit pas Firestore. Un éditeur lit son document une fois
    // (première branche) ; un lecteur aussi, sa première branche s'arrêtant
    // au claim de rôle (`hasRoleIn`).
    match /quarantine/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid)
        && ((isImportableUnder(50 * 1024 * 1024) && isEditor())
            || (isReaderImageUnder(50 * 1024 * 1024) && isApproved()));
    }

    /// Un livre entier — PDF, EPUB ou Word — à découper en recettes.
    ///
    /// Plafond de 300 Mo au lieu de 50, et seulement sous `livres/` : une page de
    /// recette n'a aucune raison de peser autant, et le dossier commun reste
    /// borné. Deux blocs `match` se recouvrent ici, et l'accès est accordé si
    /// l'un d'eux l'autorise — le premier bloc refuse toujours un fichier de plus
    /// de 50 Mo, celui-ci ne l'autorise que sous `livres/`.
    ///
    /// Même liste de types que `scanUploadHead` (`functions/src/utils/uploadSecurity.ts`),
    /// même plafond que `MAX_BOOK_UPLOAD_SIZE_BYTES` : les trois bougent ensemble.
    ///
    /// Éditeurs et administrateurs seulement : `analyzeBookImport` exige
    /// `requireEditor`, un livre déposé par un lecteur ne servait à rien.
    match /quarantine/{uid}/livres/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid)
        && request.resource.size < 300 * 1024 * 1024
        && baseContentType() in [
             'application/pdf',
             'application/epub+zip',
             'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
           ]
        && isEditor();
    }

    // Scans validés (écriture uniquement via Admin SDK / Cloud Functions).
    //
    // Lire un fichier dont on a l'adresse reste ouvert ; LISTER le dossier
    // d'un autre ne l'est pas — un listage donnait les noms des fichiers
    // sources de chacun. Le client ne liste jamais ces dossiers.
    match /scans/{uid}/{allPaths=**} {
      allow get: if isActive();
      allow list: if isActive() && (isOwner(uid) || isAdmin());
      allow write: if false;
    }

    // Images refusées par la modération — lecture ADMIN uniquement.
    //
    // Elles sont conservées, et non supprimées : sans l'image, un
    // administrateur ne peut pas juger si le refus était fondé, et une
    // modération qu'on ne peut pas évaluer ne se corrige jamais.
    //
    // Aucune URL n'est stockée sur le document : l'écran d'administration lit
    // le fichier avec les droits de celui qui le consulte. Retirer le rôle
    // admin retire l'accès dans la seconde, ce qu'un jeton de téléchargement
    // déjà émis ne permettrait pas.
    match /rejected/{uid}/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Illustrations extraites par l'IA (scan + ré-extraction manuelle)
    match /illustrations/{uid}/{allPaths=**} {
      // Lire un fichier par son adresse : tout compte actif. Lister : admin.
      allow get: if isActive();
      allow list: if isAdmin();
      allow write: if false;
    }

    // Illustrations de recettes. Dossier publié, écrit par le serveur seul :
    // `moderateAndPromoteImagesFn` (`assertTargetOwnership`) vérifie que
    // l'appelant est le créateur de la recette ou un administrateur avant d'y
    // déposer l'image modérée. Lister le dossier d'une recette — qui peut
    // être privée — est réservé à l'administrateur ; le client ne liste pas.
    match /recipes/{recipeId}/{allPaths=**} {
      allow get: if isActive();
      allow list: if isAdmin();
      allow write: if false;
    }

    // Capture d'écran jointe à un ticket — privée, jamais publiée.
    //
    // `tickets/{uid}/{ticketId}/screenshot.png|jpg`. Écriture par le compte
    // `uid` lui-même, nommé et non révoqué, PNG ou JPEG de 5 Mo au plus ;
    // lecture par ce compte ou l'administrateur. Le ticket lui-même n'est
    // pas relu ici : `attachTicketScreenshot` vérifie ensuite qu'il appartient
    // à l'appelant avant d'écrire `screenshot_path`.
    match /tickets/{uid}/{ticketId}/{fileName} {
      allow read: if (isActive() && isOwner(uid)) || isAdmin();
      allow create, update: if isOwner(uid)
        && fileName.matches('screenshot[.](png|jpg)')
        && request.resource.size <= 5 * 1024 * 1024
        && baseContentType() in ['image/png', 'image/jpeg']
        && isApproved();
    }

    // Couverture « Recette libre » par utilisateur
    match /users/{uid}/{allPaths=**} {
      // Lire un fichier par son adresse : tout compte actif. Lister : admin.
      allow get: if isActive();
      allow list: if isAdmin();
      allow write: if false;
    }
  }
}
