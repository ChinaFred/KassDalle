rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Couvertures de livres
    match /covers/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Quarantaine: zone d'atterrissage avant scan serveur
    match /quarantine/{uid}/{allPaths=**} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if isAuthenticated()
        && request.auth.uid == uid
        && request.resource.size < 50 * 1024 * 1024;
    }

    // Scans validés (écriture uniquement via Admin SDK / Cloud Functions)
    match /scans/{uid}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Illustrations extraites par l'IA (scan + ré-extraction manuelle)
    match /illustrations/{uid}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && request.auth.uid == uid
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Illustrations de recettes
    match /recipes/{recipeId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Couverture "Recette libre" par utilisateur
    match /users/{uid}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
