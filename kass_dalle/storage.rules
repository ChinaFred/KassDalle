rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Autorisation par claims, jamais par lecture inter-services ───────────
    //
    // Une version précédente interrogeait Firestore depuis ces règles pour lire
    // le rôle et `is_revoked`. Cette lecture inter-services a fait échouer les
    // règles et cassé l'import de recettes : l'envoi vers `quarantine/` était
    // refusé alors que la seule condition réelle était une égalité d'identifiant.
    //
    // Le rôle et la révocation voyagent désormais dans le jeton, entretenus par
    // le déclencheur `syncUserClaims`. Un claim se lit sans appel réseau et sans
    // coût. Son absence, en revanche, fait lever une erreur à toute comparaison
    // qui le lit (`request.auth.token.revoked != true` sur un jeton sans
    // `revoked`), et une erreur vaut refus : un claim facultatif se teste
    // d'abord par sa présence (`'revoked' in request.auth.token`). C'est la
    // seule autorisation qu'une règle Storage peut évaluer de façon fiable.

    function isAuthenticated() {
      return request.auth != null;
    }

    /// Révoqué UNIQUEMENT si le claim le dit explicitement.
    /// Un jeton sans claim `revoked` — compte ancien, claim pas encore
    /// propagé — est traité comme actif : la migration ne doit verrouiller
    /// personne dehors. La présence se teste avant la valeur : comparer une
    /// clé absente lève une erreur, et l'erreur refusait l'accès.
    function isActive() {
      return isAuthenticated()
        && (!('revoked' in request.auth.token) || request.auth.token.revoked != true);
    }

    /// Administrateur, sur la foi du claim.
    ///
    /// Sert la seule lecture qui ne soit pas ouverte à la famille : les images
    /// refusées par la modération. Un jeton sans claim n'est pas administrateur
    /// — ici l'absence de preuve vaut refus, parce que ce dossier contient
    /// précisément ce qu'on a jugé impubliable.
    function isAdmin() {
      return isActive() && request.auth.token.role == 'admin';
    }

    /// Un compte nommé : le sas d'entrée vaut aussi pour les dépôts de fichiers.
    ///
    /// Ne concerne que l'ÉCRITURE. Les lectures restent sur `isActive()` : la
    /// lecture n'a pas le filet de secours que Firestore a (relire le document
    /// quand le jeton ne porte pas encore le claim de rôle) — une règle Storage
    /// ne peut évaluer que le jeton. Un essai d'aligner la lecture sur ce
    /// même contrôle (2026-10-05) a coupé l'accès au fondateur lui-même, le
    /// temps que son jeton porte le claim. Revenu en arrière : un gain de
    /// confidentialité faible contre un compte en attente ne vaut pas le
    /// risque de couper l'accès à un compte déjà approuvé.
    function isApprovedToken() {
      return isActive()
        && request.auth.token.role in ['reader', 'editor', 'admin'];
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    /// Le type MIME sans ses paramètres : le texte collé s'envoie en
    /// `text/plain; charset=utf-8`, et une comparaison exacte le refuserait.
    function baseContentType() {
      return request.resource.contentType.split(';')[0].trim();
    }

    /// Les seuls types qu'un import de recette produit : photo, scan PDF,
    /// document Word, texte collé. Même liste que `ALLOWED_MIME_TYPES` dans
    /// `functions/src/utils/uploadSecurity.ts`, qui décide côté serveur — le
    /// fichier y est de toute façon inspecté avant d'être promu hors de la
    /// quarantaine. Ce contrôle-ci ne remplace pas cette inspection : il évite
    /// que le dépôt lui-même serve à autre chose.
    ///
    /// Sans lui, la quarantaine acceptait **n'importe quel** fichier jusqu'à
    /// cinquante mégaoctets : le bucket servait d'hébergement gratuit à qui
    /// possédait un compte, et rien dans le suivi de stockage n'aurait
    /// distingué ces octets-là des recettes de la famille.
    function isImportableUnder(maxBytes) {
      return request.resource.size < maxBytes
        && baseContentType() in [
             'image/jpeg',
             'image/png',
             'application/pdf',
             'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
             'text/plain'
           ];
    }

    // Couvertures de livres — écrites par le serveur pour le créateur du livre
    // ou un administrateur, comme le livre lui-même côté Firestore.
    // Dossiers PUBLIÉS : écriture serveur uniquement, comme `scans/`.
    //
    // Une image vue par toute la famille passe par la quarantaine et par la
    // modération avant d'atterrir ici. Laisser le client y écrire en direct
    // rendrait la modération contournable en une ligne de code.
    match /covers/{allPaths=**} {
      // Lire un fichier par son adresse : tout compte actif. Lister : admin.
      allow get: if isActive();
      allow list: if isAdmin();
      allow write: if false;
    }

    // Quarantaine : zone d'atterrissage avant le scan serveur ET la modération.
    // C'est désormais la SEULE porte d'entrée d'une image : les quatre dossiers
    // publiés sont fermés en écriture, et seul le serveur y dépose.
    // Chemin critique de l'import, et début d'une chaîne d'appels d'IA
    // facturés : la propriété du dossier ne suffit donc pas, le compte doit
    // avoir été nommé.
    // La lecture est ouverte à l'ADMINISTRATEUR en plus du propriétaire.
    //
    // Une image « à revoir » attend ici. Sans cette ligne, l'administrateur
    // chargé de trancher ne pouvait pas la voir — sauf s'il l'avait envoyée
    // lui-même — et devait donc décider à l'aveugle, sur des scores. Le seul
    // écran qui compte devenait inutilisable.
    match /quarantine/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) && isApprovedToken()
        && isImportableUnder(50 * 1024 * 1024);
    }

    /// Un livre entier — PDF, EPUB ou Word — à découper en recettes.
    ///
    /// Plafond de 300 Mo au lieu de 50, et seulement sous `livres/` : une page de
    /// recette n'a aucune raison de peser autant, et le dossier commun reste
    /// borné. Deux blocs `match` se recouvrent ici, et l'accès est accordé si
    /// l'un d'eux l'autorise — le premier bloc refuse toujours un fichier de plus
    /// de 50 Mo, celui-ci ne l'autorise que sous `livres/`.
    ///
    /// Même liste de types que `scanUploadHead` (`functions/src/utils/uploadSecurity.ts`),
    /// même plafond que `MAX_BOOK_UPLOAD_SIZE_BYTES` : les trois bougent ensemble.
    match /quarantine/{uid}/livres/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) && isApprovedToken()
        && request.resource.size < 300 * 1024 * 1024
        && baseContentType() in [
             'application/pdf',
             'application/epub+zip',
             'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
           ];
    }

    // Scans validés (écriture uniquement via Admin SDK / Cloud Functions).
    //
    // Lire un fichier dont on a l'adresse reste ouvert ; LISTER le dossier
    // d'un autre ne l'est pas — un listage donnait les noms des fichiers
    // sources de chacun. Le client ne liste jamais ces dossiers.
    match /scans/{uid}/{allPaths=**} {
      allow get: if isActive();
      allow list: if isActive() && (isOwner(uid) || isAdmin());
      allow write: if false;
    }

    // Images refusées par la modération — lecture ADMIN uniquement.
    //
    // Elles sont conservées, et non supprimées : sans l'image, un
    // administrateur ne peut pas juger si le refus était fondé, et une
    // modération qu'on ne peut pas évaluer ne se corrige jamais.
    //
    // Aucune URL n'est stockée sur le document : l'écran d'administration lit
    // le fichier avec les droits de celui qui le consulte. Retirer le rôle
    // admin retire l'accès dans la seconde, ce qu'un jeton de téléchargement
    // déjà émis ne permettrait pas.
    match /rejected/{uid}/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Illustrations extraites par l'IA (scan + ré-extraction manuelle)
    match /illustrations/{uid}/{allPaths=**} {
      // Lire un fichier par son adresse : tout compte actif. Lister : admin.
      allow get: if isActive();
      allow list: if isAdmin();
      allow write: if false;
    }

    // Illustrations de recettes. Dossier publié, écrit par le serveur seul :
    // `moderateAndPromoteImagesFn` (`assertTargetOwnership`) vérifie que
    // l'appelant est le créateur de la recette ou un administrateur avant d'y
    // déposer l'image modérée. Lister le dossier d'une recette — qui peut
    // être privée — est réservé à l'administrateur ; le client ne liste pas.
    match /recipes/{recipeId}/{allPaths=**} {
      allow get: if isActive();
      allow list: if isAdmin();
      allow write: if false;
    }

    // Capture d'écran jointe à un ticket — privée, jamais publiée.
    //
    // `tickets/{uid}/{ticketId}/screenshot.png|jpg`. Écriture par le compte
    // `uid` lui-même, nommé et non révoqué, PNG ou JPEG de 5 Mo au plus ;
    // lecture par ce compte ou l'administrateur. Pas de lecture Firestore
    // ici : `attachTicketScreenshot` vérifie ensuite que le ticket appartient
    // à l'appelant avant d'écrire `screenshot_path`.
    match /tickets/{uid}/{ticketId}/{fileName} {
      allow read: if (isActive() && isOwner(uid)) || isAdmin();
      allow create, update: if isOwner(uid) && isApprovedToken()
        && fileName.matches('screenshot[.](png|jpg)')
        && request.resource.size <= 5 * 1024 * 1024
        && baseContentType() in ['image/png', 'image/jpeg'];
    }

    // Couverture « Recette libre » par utilisateur
    match /users/{uid}/{allPaths=**} {
      // Lire un fichier par son adresse : tout compte actif. Lister : admin.
      allow get: if isActive();
      allow list: if isAdmin();
      allow write: if false;
    }
  }
}
