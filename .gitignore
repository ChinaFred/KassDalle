node_modules/
kass_dalle/functions/lib/
firebase-debug.log
firebase-debug.*.log
*.local

# Cache local de la CLI Firebase — réécrit à chaque déploiement
.firebase/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Env / secrets
*.env
.env*
