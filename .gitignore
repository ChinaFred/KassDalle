# ── Artefacts de build — jamais versionnés ────────────────────────────────────
# Un dépôt qui grossit de plusieurs Mo par release est un dépôt cassé.
release/
Release/

# Flutter / Dart
kass_dalle/build/
kass_dalle/.dart_tool/
kass_dalle/.flutter-plugins
kass_dalle/.flutter-plugins-dependencies
**/*.g.dart.lock

# Node / Cloud Functions
node_modules/
kass_dalle/functions/lib/
firebase-debug.log
firebase-debug.*.log
*.local

# Cache local de la CLI Firebase — réécrit à chaque déploiement
.firebase/

# Artefacts de session de test — QR de tunnel (ngrok, cloudflared, LAN).
# Un tunnel ne survit pas à sa session : le QR est périmé le lendemain.
# `deploy.ps1` fait un `git add -A` : sans cette règle, tout fichier laissé
# à la racine part en production avec la release suivante.
*-qr.png
*_qr.png

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Env / secrets
*.env
.env*

# Photos de banc d'essai de la detection : elles appartiennent a l'utilisateur.
kass_dalle/photos-test/
kass_dalle/photo-test/
.claude/worktrees/
